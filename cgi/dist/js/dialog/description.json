{
  "name": "dialog",
  "version": "0.1.0",
  "description": "通用弹窗组件 —— 零依赖纯前端 modal dialog，自己注入样式，颜色走 CSS 变量跟随宿主主题",
  "entry": "dialog.js",
  "global": "Dialog",
  "type": "script",
  "dependencies": [],
  "url": "dialog.js",
  "readme": "README.md",
  "tags": ["ui", "modal", "dialog", "popup"],
  "api": {
    "constructor": {
      "signature": "new Dialog(options)",
      "returns": "Dialog",
      "options": {
        "title": { "type": "string", "default": "", "desc": "标题（textContent，不解析 HTML）" },
        "message": { "type": "string", "default": "", "desc": "正文（textContent）" },
        "content": { "type": "Node|string", "default": null, "desc": "自定义正文，优先于 message；字符串按 HTML 解析，只放可信内容" },
        "okText": { "type": "string", "default": "确定", "desc": "主按钮文字" },
        "cancelText": { "type": "string", "default": "取消", "desc": "取消按钮文字" },
        "danger": { "type": "boolean", "default": false, "desc": "危险操作：主按钮变红，默认焦点在「取消」上" },
        "hideCancel": { "type": "boolean", "default": false, "desc": "隐藏取消按钮" },
        "okValue": { "type": "any", "default": "ok", "desc": "确定时 resolve 的值" },
        "maskClass": { "type": "string", "default": "dlg-mask", "desc": "遮罩层 class" },
        "onOk": { "type": "Function", "default": null, "desc": "确定前的钩子，返回 false 则不关闭" },
        "onCancel": { "type": "Function", "default": null, "desc": "取消时的钩子" }
      }
    },
    "methods": [
      {
        "name": "open",
        "signature": "dlg.open()",
        "returns": "Promise",
        "desc": "打开弹窗。确定时 resolve(okValue)，取消时 resolve(null)"
      },
      {
        "name": "close",
        "signature": "dlg.close(value)",
        "returns": "void",
        "desc": "关闭弹窗，value resolve 给 open() 的 Promise"
      }
    ],
    "statics": [
      {
        "name": "Dialog.confirm",
        "signature": "Dialog.confirm(message, options?)",
        "returns": "Promise<boolean>",
        "desc": "确认框快捷方式"
      },
      {
        "name": "Dialog.alert",
        "signature": "Dialog.alert(message, options?)",
        "returns": "Promise<void>",
        "desc": "提示框快捷方式（只有一个按钮）"
      }
    ]
  },
  "behavior": {
    "confirm": "resolve(okValue)",
    "cancel": "resolve(null)",
    "escape": "resolve(null)",
    "click_mask": "resolve(null)",
    "enter": "等同确定（焦点在 button/textarea 上时除外，避免重复触发）",
    "tab": "焦点锁在弹窗内循环",
    "focus_restore": "关闭后焦点回到打开前的元素",
    "stacking": "可叠层，只有最上面的弹窗响应 Esc 和遮罩点击"
  },
  "css": {
    "injected": true,
    "style_id": "dlg-component-style",
    "classes": [
      "dlg-mask",
      "dlg",
      "dlg-title",
      "dlg-msg",
      "dlg-actions",
      "dlg-btn",
      "dlg-btn.primary",
      "dlg-btn.danger",
      "dlg-narrow"
    ],
    "variables": {
      "--bg-2": "#1e2027",
      "--bg-3": "#262931",
      "--ink": "#e6e6e6",
      "--muted": "#8a8a94",
      "--rule": "#33363f",
      "--lime": "#c4f542",
      "--red": "#ff4d4d"
    }
  },
  "examples": [
    {
      "title": "确认框",
      "code": "const yes = await Dialog.confirm('清空文档？', { danger: true });"
    },
    {
      "title": "提示框",
      "code": "await Dialog.alert('已保存。');"
    },
    {
      "title": "完整用法",
      "code": "const dlg = new Dialog({ title: '修改名字', message: '这个名字会显示给同房间的人。' });\nconst result = await dlg.open();  // 'ok' 或 null"
    }
  ],
  "notes": [
    "危险操作默认焦点在「取消」上 —— 打开时回车不会误触发危险动作",
    "回车在 <button> 上时不重复触发（否则会触发两次）",
    "样式自己注入，宿主页面只需定义 CSS 变量就能跟随主题",
    "README.md 不能通过 /pub/ 访问 —— cgi/pub 的 MIME 表没有 .md"
  ]
}
