def g_form():
    cd = ('form-data; name="f"; filename="fallback.txt"; '
          "filename*=UTF-8''%E6%8A%A5%E5%91%8A.txt")
    out = {}
    out['rfc5987'] = FormItem({'Content-Disposition': cd}, b'x').filename
    out['name'] = FormItem({'Content-Disposition': 'form-data; name="f"'}, b'x').name
    out['file_q'] = FormItem(
        {'Content-Disposition': 'form-data; name="f"; filename="a.txt"'}, b'x').is_file()
    out['nofile_q'] = FormItem(
        {'Content-Disposition': 'form-data; name="f"'}, b'x').is_file()
    out['to_h_size'] = FormItem(
