# ── Rsp ────────────────────────────────────────────────────────────────────
def g_rsp():
    out = {}
    r = Rsp()
    out['default_code'] = r.code
    out['default_status'] = r.status
    r.code = 201
    r.status = 'Created'
    out['code_set_get'] = [r.code, r.status]

    def f(fn):
        x = Rsp()
        getattr(x, fn)()
        return [x.code, x.status]

    out['fail_404'] = f('fail_404')
    out['fail_500'] = f('fail_500')
    out['fail_403'] = f('fail_403')
    out['fail_400'] = f('fail_400')
    out['fail_405'] = f('fail_405')
    out['fail_501'] = f('fail_501')

    out['type_json'] = Rsp().type_json().header['Content-Type']
    out['type_html'] = Rsp().type_html().header['Content-Type']
    out['type_text'] = Rsp().type_text().header['Content-Type']
    out['type_xml'] = Rsp().type_xml().header['Content-Type']
    out['default_headers'] = dict(Rsp.DEFAULT_HEADERS)

    c = Rsp()
    c.cookie_set('a', '1')
    c.cookie_set('b', '2')
    out['cookie_set'] = c.header.get('Set-Cookie')

    rd = Rsp().redirect_to('/x')
    out['redirect_302'] = [rd.code, rd.status, rd.header.get('Location')]
    rd2 = Rsp().redirect_to('/x', code=301)
    out['redirect_301'] = [rd2.code, rd2.status]

    hr = Rsp()
    hr.header_field('X-A', 'a')
    hr.header_remove('Content-Type')
    out['header_ops'] = dict(hr.header)
    out['respond_chunk'] = hasattr(Rsp(), 'chunk')
    out['respond_stream'] = hasattr(Rsp(), 'stream')
    out['sent_init'] = Rsp().sent
    return out


probe('rsp', g_rsp)

# ── Body ───────────────────────────────────────────────────────────────────
def g_body():
    page = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'page.html')
    out = {}
    out['wrap_nil'] = [type(Body.wrap(None)).__name__, Body.wrap(None).size()]
    out['wrap_str'] = type(Body.wrap('hello')).__name__
    out['text_size_cjk'] = Body.wrap('报告').size()
    out['wrap_file'] = type(Body.wrap(page)).__name__
    out['wrap_pathname'] = type(Body.wrap(pathlib.Path(page))).__name__
    out['file_size'] = Body.wrap(page).size()
    out['wrap_stringio'] = type(Body.wrap(io.StringIO('abc'))).__name__
    out['wrap_proc'] = type(Body.wrap(lambda emit, n: emit(b'x'))).__name__
    out['wrap_block'] = type(Body.wrap(None, lambda emit, n: emit(b'x'))).__name__
    out['stream_size'] = repr(Body.wrap(lambda emit, n: emit(b'x')).size())

    acc = []
    for c in Body.wrap('hello world').each_chunk(4):
        acc.append(c.decode())
    out['text_chunk_ignores_size'] = acc

    acc = []
    for c in Body.wrap(page).each_chunk(8):
        acc.append(len(c))
    out['file_chunk_sizes'] = acc

    acc = []

    def _pump(emit, n, _s=Body):
        for i in range(3):
            emit(f'c{i}'.encode())
    for c in Body.wrap(_pump).each_chunk(1024):
        acc.append(c.decode())
    out['stream_chunks'] = acc

    tb = Body.wrap('z')
    out['wrap_identity'] = Body.wrap(tb) is tb
    return out


probe('body', g_body)

# ── 模板 ───────────────────────────────────────────────────────────────────
def render(tpl, **kw):
    r = Rsp()
    r.set_body(tpl)
    r.render(**kw)
    return r.body.to_text()


def g_render():
    out = {}
    out['puts'] = render('@<{print("hi")}>')
    out['expr'] = render('@<{1 + 1}>')
    # Ruby: puts "a"; 42  → Python eval 不收语句, 用元组取第二值
    out['puts_wins'] = render('@<{(print("a"), 42)[1]}>')
    out['raise'] = render('@<{ raise ValueError("boom") }>')
    out['undefined'] = render('@<{ NoSuchName_zz }>')
    out['brace_block'] = render('@<{ sorted([3,1,2], key=lambda x: x) }>')
    out['hash_lit'] = render('@<{ {"a": 1} }>')
    out['multi_hole'] = render('@<{ 1 }>-@<{ 1 + 1 }>-@<{ 1 + 2 }>')
    out['do_end'] = render(
        '@<{\n'
        '  [print("<li>" + str(n) + "</li>") for n in [1, 2, 3]]\n'
        '}>')
    out['trunc_brace'] = render('@<{ " }> " }>')
    out['no_hole'] = render('plain')
    out['empty_hole'] = render('@<{}>')
    out['none_var'] = render('@<{v}>', v=None)
    out['string_lit'] = render('@<{ "}" }>')
    out['pct_literal'] = render("@<{ 'a' }>")
    r = Rsp()
    r.set('v', 'from-set')
    r.set_body('@<{v}>')
    r.render(v='from-hash')
    out['render_kw_over_set'] = r.body.to_text()
    r = Rsp()
    r.set('v', 'from-set')
    r.set_body('@<{v}>')
    r.render()
    out['set_inject'] = r.body.to_text()
    r = Rsp()
    r.set({'k': 'v1'})
    r.set_body('@<{k}>')
    r.render()
    out['set_hash'] = r.body.to_text()

    def _cap():
        print('to-stdout')
        return 99
    cap, ret = capture_stdout(_cap)
    out['capture'] = [cap, ret]
    return out


probe('render', g_render)

# ── Req ────────────────────────────────────────────────────────────────────
def g_req():
    req = Req()
    out = {}
    out['param_none'] = repr(req.param('nope'))
    out['param_default'] = req.param('nope', 'fallback')
    out['header_def'] = req.header('x-nope', 'x')
    out['cookie_def'] = req.cookie('nope', 'x')
    out['named_def'] = req.named('nope', 'x')
    out['argv_oob'] = req.argv(999, 'x')
    out['argv_neg'] = req.argv(-1, 'x')
    out['params_class'] = 'Hash' if isinstance(req.params, dict) else type(req.params).__name__
    out['cookies_class'] = 'Hash' if isinstance(req.cookies, dict) else type(req.cookies).__name__
    out['body_len_class'] = type(req.body_length).__name__
    out['argv_count'] = req.argv_count
    out['method'] = req.method
    out['path'] = req.path
    out['query'] = req.query
    out['body_len_zero'] = req.body_length == 0
    if req.body_length == 0:
        out['body_nil'] = repr(req.body())
        out['body_json_nil'] = repr(req.body_json())
        out['body_text_nil'] = repr(req.body_text())
        out['form_nil'] = repr(req.body_form_data())
    else:
        raw = req.body()
        out['body_class'] = 'String' if isinstance(raw, bytes) else type(raw).__name__
        out['body_bytes'] = len(raw) if raw is not None else None
        out['body_again'] = repr(req.body())
        out['body_json_after'] = repr(req.body_json())
        out['body_text_after'] = repr(req.body_text())
    return out


probe('req', g_req)

