# 走框架自己的 Rsp / 路由, 而不是手写 HTTP 头 ——
# 这样对拍的是「框架产出的响应字节」, 而不只是「两边都打印了 JSON」。
# 用 '/*' 而不是 '/': MAP_PATH 非空时也要能跑同一份断言
# 注意: '/*' 是「**非空** restful 通配」, 只在 MAP_PATH 非空时命中。
# MAP_PATH='/'(脚本自身 URL) 要另外注册 '/' 才跑得到 —— 漏了这条的话
# 直接访问本脚本会 404, 只有带 /users/42 之类路径才通。

def _parity(req, rsp):
    rsp.ok_json({'parity': 'py', 'map_path': Q.MAP_PATH,
                 'results': jsafe(OUT)}).finish()


# MAP_PATH='/' 与非空 restful 两种形态都要能跑
Q.route('/', method=['GET'])(_parity)
Q.route('/*', method=['GET'])(_parity)

Q.run()