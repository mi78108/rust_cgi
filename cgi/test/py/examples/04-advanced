# ── multipart 上传 ──────────────────────────────────────────────────────
@Q.get('/upload')
def upload_form(req, rsp):
    rsp.ok_html(
        '<form method="POST" enctype="multipart/form-data" action="/test/pyex/04/advanced/upload">'
        '<input type="file" name="f"><button>上传</button></form>'
    ).finish()


@Q.post('/upload')
def upload(req, rsp):
    # body_form_data 需要 _ext_form_ —— 不 import 就 NameError
    from _ext_form_ import Form  # noqa: F401

    form = req.body_form_data()
    if form is None:
        return rsp.fail_400().type_text().set_body(
            '需要 multipart/form-data').finish()

    saved = []
    for item in form.each_file():
        target = f'/tmp/pyex_upload_{os.getpid()}_{item.filename}'
        item.save_to(target)
        saved.append({**item.to_h(), 'to': target})

    rsp.ok_json({
        'parts': len(form),
        'files': form.files_count(),
        'items': [i.to_h() for i in form.items],
        'saved': saved,
    }).finish()


# ── 静态资源 ─────────────────────────────────────────────────────────────
# cgi/pub 是 Ruby 写的静态文件服务器, Python 侧不能直接 exec —— 没有
# 定义 Q.route / Q.get 这些 Ruby 专有调用。
# 用框架自己的 Body 抽象直接发文件, 和 Ruby 版的 pub 行为对齐:
# MIME 按扩展名查, 路径做穿越防护。
MIME = {
    '.html': 'text/html; charset=utf-8', '.css': 'text/css; charset=utf-8',
    '.js': 'text/javascript; charset=utf-8', '.json': 'application/json; charset=utf-8',
    '.txt': 'text/plain; charset=utf-8', '.svg': 'image/svg+xml',
    '.png': 'image/png', '.jpg': 'image/jpeg', '.gif': 'image/gif',
    '.ico': 'image/x-icon', '.woff2': 'font/woff2', '.map': 'application/json',
}
STATIC_ROOT = os.path.join(CGI_ROOT, 'pub')
# pub 本身是个**文件**(Ruby 的静态服务器), 不是资源目录。真正可serve 的
# 静态资源在各业务目录下(例如 root/dist、root/posts/dist)。这里把它们
# 收集成一个可 serve 的白名单, 与 pub 的思路一致(按相对路径取)。
STATIC_MOUNTS = {
    'posts': os.path.join(CGI_ROOT, 'root', 'posts', 'dist'),
    'root': os.path.join(CGI_ROOT, 'root', 'dist'),
}



@Q.get('/static')
def static_index(req, rsp):
    listing = {}
    for mount, root in STATIC_MOUNTS.items():
        listing[mount] = sorted(os.listdir(root))[:20] if os.path.isdir(root) else []
    rsp.ok_json({
        'mounts': listing,
        'usage': '/static/posts/index.html  ·  /static/root/style.css',
    }).finish()


# 用一个入口处理 /static 下的一切, 内部按 MAP_PATH 分流。这样不用纠结
# 多条 pattern 的注册顺序与优先级。
#
# 两个实测出来的约束:
#   1) '/*' 不是子路径通配符 —— 框架只在 pattern **正好等于** '/*' 时才
#      无条件命中(`if pattern == '/*': return True` 早返回);
#      '/static/*' 里的 * 只当正则元字符, 匹配不了多段。
#   2) '<name>' 只吃单段([^/]+), 所以 '/static/<path>' 匹配不到
#      '/static/posts/index.html'。要任意段数必须用 re.Pattern。
@Q.get(re.compile(r'/static(/.*)?'))
def static_or_fallback(req, rsp):
    # req.path 就是 MAP_PATH, 去掉 '/static/' 前缀就是相对路径
    rel = req.path[len('/static/'):] if req.path.startswith('/static/') else ''
    if not rel or rel.endswith('/'):
        return static_index(req, rsp)

    mount, _, name = rel.partition('/')
    if not name:
        return rsp.fail_404().type_text().set_body(
            '用法: /static/<mount>/<file>\n').finish()

    root = STATIC_MOUNTS.get(mount)
    if not root:
        return rsp.fail_404().type_text().set_body(
            f'unknown mount: {mount}\n可用: {", ".join(STATIC_MOUNTS)}\n').finish()
    # 穿越防护
    if '..' in name or name.startswith('/') or '..' in mount:
        return rsp.fail_400().type_text().set_body(f'invalid path: {mount}/{name}').finish()

    full = os.path.join(root, name)
    if not os.path.isfile(full):
        return rsp.fail_404().type_text().set_body(
            f'not found: {mount}/{name}\n'
            f'该 mount 下有: {", ".join(sorted(os.listdir(root))[:10])}\n').finish()

    mime = MIME.get(os.path.splitext(full)[1].lower())
    if mime is None:
        return rsp.fail_404().type_text().set_body(
            f'unsupported extension: {os.path.splitext(full)[1]}').finish()

    # set_body 传路径字符串会被 Body.wrap 识别成文件 → FileBody, 分块读
    rsp.type(mime).set_body(full).finish()


# ── WebSocket ───────────────────────────────────────────────────────────
# spider 负责握手与帧编解码, CGI 只看到裸 payload。
# req.on_ws_data 循环读帧; block 返回值会被写回客户端。
@Q.ws('/ws')
def ws_echo(req, rsp):
    Q.log('[ws] client connected')
    Q.on_close(lambda: Q.log('[ws] client disconnected'))

    def on_frame(chunk: bytes):
        # chunk 是裸 bytes, 不含 ws frame 头
        try:
            text = chunk.decode('utf-8')
        except UnicodeDecodeError:
            return b'error: not utf-8\n'
        return f'echo: {text}\n'.encode()

    req.on_ws_data(on_frame)


# 一个 SSE 风格的长连接示例(普通 HTTP, 不是 ws)
@Q.get('/events')
def events(req, rsp):
    rsp.type('text/event-stream').stream(
        lambda i: f'event: tick\ndata: {i}\n\n' if i < 5 else None
    )


# ── 自定义 header + 大 body ─────────────────────────────────────────────
@Q.get('/headers')
def headers(req, rsp):
    rsp.header_field('X-Powered-By', 'spider/py')
    rsp.header_field('X-Request-Map', req.path)
    rsp.ok_json({'ok': True}).finish()


Q.run()