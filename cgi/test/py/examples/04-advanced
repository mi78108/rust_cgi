#!/usr/bin/env python3
"""04-advanced — 流式、文件、WebSocket、上传、静态资源.

演示这些容易踩坑的形态:
  * stream(): chunked 响应, 分块产出
  * send_file(): 静态文件 + Content-Disposition
  * Q.ws + req.on_ws_data(): WebSocket 双向
  * multipart 上传(需 import _ext_form_)
  * 加载 cgi/pub 做静态资源服务
  * cookie / 重定向 / 自定义 header

    curl -s  http://172.19.0.1:8080/test/pyex/04/advanced/stream
    curl -sI http://172.19.0.1:8080/test/pyex/04/advanced/download
    curl -sI http://172.19.0.1:8080/test/pyex/04/advanced/cookie
    curl -s  http://172.19.0.1:8080/test/pyex/04/advanced/redirect
    curl -s -F 'f=@/etc/hostname' http://172.19.0.1:8080/test/pyex/04/advanced/upload
    curl -s  http://172.19.0.1:8080/test/pyex/04/advanced/static/style.css
"""

import json
import os
import re
import sys

sys.path.insert(0, os.path.join(os.environ['Cgi_Root'], '_env_', 'python'))

from _base_ import Q, Body  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
CGI_ROOT = os.environ['Cgi_Root']


# ── 索引 ─────────────────────────────────────────────────────────────────
@Q.get('/')
def index(req, rsp):
    """MAP_PATH=/ 就是脚本自身 URL。"""
    rsp.ok_json({
        'endpoints': [
            'GET  /stream       chunked, 生成器风格',
            'GET  /stream2      chunked, Body 块接口',
            'GET  /download     文件下载 (Content-Disposition)',
            'GET  /cookie       Set-Cookie + 读 cookie',
            'GET  /redirect     302',
            'GET  /redirect301  301',
            'GET  /upload       上传表单 (GET)',
            'POST /upload       收 multipart',
            'GET  /static       静态资源索引',
            'GET  /static/*     静态资源 (走 cgi/pub)',
            'WS   /ws           WebSocket echo',
            'GET  /events       SSE 风格长连接',
            'GET  /headers      自定义 header',
        ],
        'argv': list(Q.ARGV),
        'argv_count': req.argv_count,
        'peer': Q.PEER_ADDR,
    }).finish()


# ── chunked 流式 ─────────────────────────────────────────────────────────
# stream() 切 Transfer-Encoding: chunked。block 收一个计数器,
# 返回 chunk 字符串, 返回 None/''/False 停止。
@Q.get('/stream')
def stream(req, rsp):
    rsp.type('text/plain; charset=utf-8').stream(
        lambda i: f'chunk {i}\n' if i < 5 else None
    )


# 也可以用 Body 的流式接口自己控制粒度:
@Q.get('/stream2')
def stream2(req, rsp):
    def pump(emit, chunk_size):
        for i in range(10):
            emit(f'line {i:02d} ' + '.' * (i * 3) + '\n')
    rsp.type_text().set_body(None, pump).stream()


# ── 静态文件下载 ────────────────────────────────────────────────────────
@Q.get('/download')
def download(req, rsp):
    path = os.path.join(HERE, 'sample.txt')
    if not os.path.isfile(path):
        return rsp.fail_404().ok_text('sample.txt 不存在').finish()
    # send_file 设 Content-Disposition; 文件不存在时自动转 404
    rsp.send_file(path,
                  mime='text/plain; charset=utf-8',
                  download_as='sample.txt').finish()


