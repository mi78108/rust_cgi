#!/usr/bin/env python3
"""Python 框架行为探针.

每条断言把「实际观察到的值」原样返回, 不做布尔化 —— 值本身才是证据。
用法:
    curl -s 'http://172.19.0.1:8080/test/framework/py_probe2' | jq .
"""

import sys, os, io, re, json
sys.path.insert(0, os.path.join(
    os.environ.get('Cgi_Root', os.getcwd()), '_env_', 'python'))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '_env_', 'python'))

from _base_ import (  # noqa: E402
    Q, QEnv, Req, Rsp, Body, TextBody, FileBody, StreamBody,
    log, capture_stdout, read, write, write_headers, write_chunk,
    write_chunk_end, write_resp, match_pattern, run, on_close,
)

R = []


def check(name, want, got, note=None):
    e = {'name': name, 'ok': want == got, 'want': want, 'got': got}
    if note:
        e['note'] = note
    R.append(e)


def expect_raise(name, exc_types, note=None):
    try:
        yield_fn = None  # noqa: F841
    except BaseException:
        pass
    check(name, True, True)  # placeholder, replaced below


def raised(name, exc_types, fn, note=None):
    try:
        fn()
        got = '(no exception)'
    except BaseException as e:
        got = type(e).__name__
    check(name, exc_types, got, note)


def group(name):
    try:
        yield_ = None
    except Exception:
        pass


def G(name, fn):
    try:
        fn()
    except BaseException as e:
        R.append({'name': f'{name} [group aborted]', 'ok': False,
                  'want': '(no crash)', 'got': f'{type(e).__name__}: {e}',
                  'note': '用例自身抛异常, 该组后续断言未执行'})


