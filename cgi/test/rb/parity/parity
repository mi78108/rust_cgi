# 用 '/*' 而不是 '/': MAP_PATH 非空时也要能跑同一份断言
Q.route '/*', method: :GET do |_req, rsp|
  rsp.ok_json({ parity: 'rb', map_path: Q::MAP_PATH, results: OUT }).finish
end