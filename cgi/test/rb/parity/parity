#!/usr/bin/env ruby
# frozen_string_literal: true
#
# cgi/test/parity/rb — 对拍基准 (Ruby 侧)
#
# 与 cgi/test/parity/py 输出同构的 JSON。diff 两个文件即可看出
# Python 实现与 Ruby 实现在行为上的差异。
#
#   curl -s http://172.19.0.1:8080/test/parity/rb | jq .
#   curl -s http://172.19.0.1:8080/test/parity/py | jq .
#   diff <(ruby侧) <(python侧)
#
# 只断言「框架对外可观测的行为」—— 匹配结果、响应字节、模板输出。
# 内部实现差异(类名/变量名)不纳入对拍。

require_relative '../../../_env_/ruby/_base_'

OUT = {}

def probe(name)
  OUT[name] = yield
rescue StandardError, ScriptError => e
  OUT[name] = "RAISED #{e.class}: #{e.message}"
end

