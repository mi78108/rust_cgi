#!/usr/bin/env ruby
# frozen_string_literal: true
#
# cgi/test/framework/gsub_probe — 定位 @<{}> 的真实切分规则
#
# 目的: 确定 render 的正则到底把 code 截到哪, 以及 eval 结果如何被 capture_stdout 处理。
# GET /test/framework/gsub_probe

require_relative '../../../_env_/ruby/_base_'

RE = %r|@<\{(?<code>.*?)\}>|m

def probe(label, tpl)
  m = RE.match(tpl)
  code = m && m[:code]
  ctx = binding
  r = Q::Rsp.new
  r.body(tpl).render
  {
    label: label,
    tpl: tpl,
    matched: !m.nil?,
    code: code,
    code_class: code.class.name,
    code_repr: code.inspect,
    rendered: r.body.to_s
  }
end

Q.get '/' do |_req, rsp|
  cases = [
    ['hash block in hole', '@<{ [3,1,2].sort { |a, b| a <=> b } }>'],
    ['do/end in hole', '@<{ [3,1,2].sort do |a, b| a <=> b end }>'],
    ['two holes one with {}', '@<{ 1 }>-@<{ [3,1,2].sort { |a,b| a<=>b } }>-@<{ 3 }>'],
    ['hash literal in hole', '@<{ {"a" => 1} }>'],
    ['json-ish braces', '@<{ {"k": "v"}.to_s }>'],
    ['string with brace', '@<{ "}" }>'],
    ['percent literal brace', '@<{ %({a: 1}) }>'],
    ['raise', '@<{ raise "boom" }>'],
    ['expression', '@<{ 1 + 1 }>'],
    ['puts', '@<{ puts "x" }>'],
    ['empty', '@<{}>']
  ]

  rsp.ok_json(
    ok: true,
    cases: cases.map { |label, tpl| probe(label, tpl) },
    # 直接看正则贪婪程度
    greedy_check: {
      'sort{...}' => %r|@<\{(?<code>.*?)\}>|m.match('@<{ [3,1,2].sort { |a,b| a<=>b } }>')[:code],
      'greedy' => %r|@<\{(?<code>.*)\}>|m.match('@<{ 1 }>-@<{ 2 }>')[:code]
    }
  ).finish
end