# ─────────────────────────────────────────────────────────────
group 'body' do
  page = File.join(__dir__, 'page.html')

  check('wrap(nil) → TextBody("")', 'Q::Body::TextBody', Q::Body.wrap(nil).class.name)
  check('wrap(nil) 内容为空串', 0, Q::Body.wrap(nil).size)
  check('wrap(普通字符串) → TextBody', 'Q::Body::TextBody', Q::Body.wrap('hello').class.name)
  check('TextBody#size 是字节数', 6, Q::Body.wrap('报告').size, 'UTF-8 每字 3 字节')

  check('wrap(存在的文件路径字符串) → FileBody', 'Q::Body::FileBody',
        Q::Body.wrap(page).class.name)
  check('wrap(Pathname) → FileBody', 'Q::Body::FileBody',
        Q::Body.wrap(Pathname(page)).class.name)
  check('FileBody#size 等于文件字节数', File.size(page), Q::Body.wrap(page).size)

  require 'stringio'
  check('wrap(StringIO) → StreamBody', 'Q::Body::StreamBody',
        Q::Body.wrap(StringIO.new('abc')).class.name)
  check('wrap(File.open) → StreamBody', 'Q::Body::StreamBody',
        Q::Body.wrap(File.open(page, 'rb')).class.name)
  check('wrap(proc) → StreamBody', 'Q::Body::StreamBody',
        Q::Body.wrap(proc { |emit| emit.call('x') }).class.name)
  check('wrap(&block) → StreamBody', 'Q::Body::StreamBody',
        Q::Body.wrap { |emit| emit.call('x') }.class.name)

  tb = Q::Body::TextBody.new('z')
  check('wrap(Body 实例) 原样返回(不重新包装)', true, Q::Body.wrap(tb).equal?(tb))

  check('StreamBody#size 恒 nil(→ finish 走 chunked)', nil,
        Q::Body.wrap(proc { |emit| emit.call('x') }).size)

  chunks = []
  Q::Body.wrap(proc { |emit| 3.times { |i| emit.call("c#{i}") } })
          .each_chunk(1024) { |c| chunks << c }
  check('StreamBody#each_chunk 逐块 yield', %w[c0 c1 c2], chunks)

  fc = []
  Q::Body.wrap(page).each_chunk(8) { |c| fc << c.bytesize }
  check('FileBody#each_chunk 按 chunk_size 切首块', 8, fc.first)
  check('FileBody 分块后总字节数不变', File.size(page), fc.sum)

  tc = []
  Q::Body.wrap('hello world').each_chunk(4) { |c| tc << c }
  check('TextBody#each_chunk 忽略 chunk_size 整块 yield', ['hello world'], tc)

  begin
    Q::Body::TextBody.new('x').size2
  rescue NoMethodError
    nil
  end
  check('Body 子类不用 String/File/Stream 命名(避免 ::String 歧义)', true,
        Q::Body.constants.sort.include?(:TextBody))
end

# ─────────────────────────────────────────────────────────────
group 'render' do
  # puts 才是输出方式; 表达式返回值只在无输出时使用。puts 会带 \n。
  r = Q::Rsp.new
  r.body('@<{puts "hi"}>').render
  check('@<{puts "hi"}> 输出 hi + 换行', "hi\n", r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{1 + 1}>').render
  check('@<{1+1}> 无 puts 时用返回值', '2', r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{ puts "a"; 42 }>').render
  check('puts 与返回值并存时 puts 胜出(丢弃返回值)', "a\n", r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{ raise "boom" }>').render
  check('异常渲染为 [ERROR: ...] 而不抛出', '[ERROR: RuntimeError: boom]', r.body.to_s)

  r = Q::Rsp.new
  r.set(v: 'from-set')
  r.body('@<{v}>').render(v: 'from-hash')
  check('render hash 覆盖 rsp.set 同名变量', 'from-hash', r.body.to_s)

  r = Q::Rsp.new
  r.set(v: 'from-set')
  r.body('@<{v}>').render
  check('rsp.set 注入的实例变量可被 @<{}> 读到', 'from-set', r.body.to_s)

  r = Q::Rsp.new
  r.set('k' => 'v1')
  r.body('@<{k}>').render
  check('rsp.set 接受 Hash 形式', 'v1', r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{ User.new }>').render rescue nil
  r = Q::Rsp.new
  r.body('@<{ NoSuchConst_zz }>').render
  check('未定义常量渲染成错误标记而非抛出', true, r.body.to_s.start_with?('[ERROR:'))

  # 终止符是字面序列 }>(非贪婪 .*? 必须后跟 >), 所以洞里可以用 {} 块。
  # 真正会坏的只有洞里出现 }> 这个序列(如下)。
  r = Q::Rsp.new
  r.body('@<{ [3,1,2].sort { |a, b| a <=> b } }>').render
  check('洞内可以用 {} 块(终止符是字面 }> 而非第一个 })', '[1, 2, 3]', r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{ [3,1,2].sort do |a, b| a <=> b end }>').render
  check('洞内 do/end 正常求值(结果被 to_s)', '[1, 2, 3]', r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{ {"a" => 1} }>').render
  check('洞内 hash 字面量正常', '{"a"=>1}', r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{ 1 }>-@<{ [3,1,2].sort { |a,b| a<=>b } }>-@<{ 3 }>').render
  check('多个洞 + 中间含 {} 块, 各洞独立求值', '1-[1, 2, 3]-3', r.body.to_s)

  # 唯一的真限制: 洞内出现 }> 会被误认成洞结束 → code 残缺 → SyntaxError
  r = Q::Rsp.new
  r.body('@<{ " }> " }>').render
  check('洞内出现 }> 会截断 → 渲染成错误标记', true,
        r.body.to_s.start_with?('[ERROR:'),
        '限制: 终止符是字面 }>, 所以洞里不能出现这个序列')
  check('洞内 }> 截断的错误类型是 SyntaxError', true,
        r.body.to_s.include?('SyntaxError'),
        "实际输出: " + r.body.to_s[0, 90])

  tpl = '@<{' + "\n" +
        '  [1,2,3].each do |n|' + "\n" +
        '    puts "<li>" + n.to_s + "</li>"' + "\n" +
        '  end' + "\n" +
        '}>'
  r = Q::Rsp.new
  r.body(tpl).render
  check('多行 do/end 模板正常渲染', "<li>1</li>\n<li>2</li>\n<li>3</li>\n", r.body.to_s)

  r = Q::Rsp.new
  r.body('plain').render
  check('render 无洞时原样保留', 'plain', r.body.to_s)

  r = Q::Rsp.new
  r.body('@<{}>').render
  check('空洞渲染为空串', '', r.body.to_s)

  captured, ret = Q.capture_stdout { puts 'to-stdout'; 99 }
  check('capture_stdout 返回 [输出, 返回值]', ["to-stdout\n", 99], [captured, ret])

  r = Q::Rsp.new
  r.body('@<{v}>').render(v: nil)
  check('render 传 nil → 渲染空串', '', r.body.to_s)
end

