#!/usr/bin/env ruby
# frozen_string_literal: true
#
# cgi/test/framework/index — _base_.rb / _ext_form_.rb / _ext_notify_.rb 框架自检
#
# 定位: 只断言「框架自身行为」, 不碰业务。cgi/test/ 下原有的 demo 端点是
# 手写试验台(本身有 bug, 比如 rsp.chunk 已从框架删除但 demo 仍在调),
# 不能拿来当框架依据 —— 这套用例独立、可重复。
#
# 跑法 (宿主机 8080, 容器内用 172.19.0.1):
#   curl -s 'http://172.19.0.1:8080/test/framework'                       | jq .
#   curl -s 'http://172.19.0.1:8080/test/framework?expect_map=/users/42' | jq .
#   curl -s 'http://172.19.0.1:8080/test/framework/users/42'             | jq .
#   curl -s 'http://172.19.0.1:8080/test/framework/demo/u/7'             | jq .
#   curl -s 'http://172.19.0.1:8080/test/framework/probe'               | jq .
#
# expect_map: 断言 MAP_PATH 等于该值。MAP_PATH = "/" + Req_Argv_Params, 即
# spider 剥掉脚本位置后剩下的路径段 —— 用不同 URL 驱动同一脚本即可验证它:
#   /test/framework            → MAP_PATH = /
#   /test/framework/users/42   → MAP_PATH = /users/42
#   /test/framework/demo/u/7   → MAP_PATH = /demo/u/7
#
# 注意: 宿主机的 spider 看到的路径前缀是 /home/hawk/Projects/RustProjects/rust_cgi,
# 容器里是 /opt/user/Projects/RustProjects/rust_cgi —— 同一份文件, 两个挂载点。
# 用例里凡是要断言路径的, 一律用 __dir__ / Cgi_Root 推导, 不写死任一侧。
#
# 输出: { ok, total, passed, failed, map_path, script, results: [...] }

require_relative '../../../_env_/ruby/_base_'

RESULTS = []

# 每个 group 独立 rescue —— 一条断言写错不会带塌整份报告
def group(name)
  yield
rescue StandardError, ScriptError => e
  RESULTS << { name: "#{name} [group aborted]", ok: false,
               want: '(no crash)', got: "#{e.class}: #{e.message}",
               note: '用例自身抛异常, 该组后续断言未执行' }
end

def check(name, want, got, note = nil)
  entry = { name: name, ok: (want == got), want: want, got: got }
  entry[:note] = note if note
  RESULTS << entry
end

def expect_raise(name, klass, note = nil)
  yield
  check(name, klass.to_s, '(no exception)', note)
rescue StandardError, ScriptError => e
  check(name, klass.to_s, e.class.to_s, note)
end

def skip(name, why)
  RESULTS << { name: name, ok: true, want: '(skipped)', got: '(skipped)', note: why }
end

