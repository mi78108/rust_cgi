# ─────────────────────────────────────────────────────────────
group 'routing' do
  expect_raise('非 / 开头的 String pattern 抛 ArgumentError', 'ArgumentError') do
    Q.match_pattern?('foo')
  end
  check("'/*' 总是匹配", true, Q.match_pattern?('/*'))
  check('nil pattern 总是匹配', true, Q.match_pattern?(nil))

  Q.match_pattern?(%r{(?<s>.*)})
  check('regex 捕获写入 Q::MATCH', true, Q::MATCH.key?(:s))
  Q.match_pattern?(nil)
  check('Q::MATCH 在下一次匹配前被清空', {}, Q::MATCH)

  # 真实行为: 不含元字符的纯字符串 pattern 走 else 分支, 拿 REQ_PATH(完整 URL) 比,
  # 不是拿 MAP_PATH 比。写 Q.get '/a/b' 时想匹配的是完整 URL 路径, 不是 restful 部分。
  check('纯字符串 pattern 与 REQ_PATH 比(不是 MAP_PATH)', true,
        Q.match_pattern?(Q::REQ_PATH))
  check('纯字符串 pattern 与 MAP_PATH 不同时不匹配', false,
        Q.match_pattern?('/definitely-not-the-url-path'),
        '这条测的是"别指望纯字符串 pattern 能按 restful 部分匹配"')
end

# ─────────────────────────────────────────────────────────────
group 'routing@map' do
  if EXPECT_MAP.empty?
    skip('MAP_PATH 路径匹配', '需带 ?expect_map=/users/42 或用 /users/42 URL 驱动')
  else
    check("MAP_PATH == expect_map(#{EXPECT_MAP})", EXPECT_MAP, MAP)
    check('实际 MAP_PATH', MAP, EXPECT_MAP)

    case MAP
    when '/'
      check("pattern '/' 命中", true, Q.match_pattern?('/'))
      check("pattern '/info' 不命中", false, Q.match_pattern?('/info'))
      check("pattern '/<name>' 不匹配 '/'([^/]+ 要求至少一字符)", false,
            Q.match_pattern?('/<name>'))
      check('regex %r{(?<a>.+)} 捕获', 'x',
            (Q.match_pattern?(%r{(?<a>.+)}) && Q::MATCH[:a]),
            '配合 /test/framework/x 驱动')
    when '/users/42'
      check("pattern '/users/<id>' 命中并捕获 42", '42',
            (Q.match_pattern?('/users/<id>') && Q::MATCH[:id]))
      check("pattern '/users/<id>' 不吃 '/users/a/b'", false, Q.match_pattern?('/users/a/b'))
      check("pattern '/<a>/<b>' 双捕获", %w[users 42],
            (Q.match_pattern?('/<a>/<b>') && [Q::MATCH[:a], Q::MATCH[:b]]))
      check('regex 无锚点 %r{/users/(?<id>\d+)} 命中', '42',
            (Q.match_pattern?(%r{/users/(?<id>\d+)}) && Q::MATCH[:id]))
      check('字符串含元字符 . 被当正则: /a.b 匹配 /axb', true,
            Q.match_pattern?('/a.b'),
            '坑: 期望字面量路径, 却因 . 变成通配')
    when '/demo/u/7'
      check('regex %r{/u/(?<id>\d+)} 捕获 7', '7',
            (Q.match_pattern?(%r{/u/(?<id>\d+)}) && Q::MATCH[:id]))
      check('regex 带 ^...$ 锚点同样命中', '7',
            (Q.match_pattern?(%r{^/u/(?<id>\d+)$}) && Q::MATCH[:id]))
      check("字符串 pattern '/u/<id>' 捕获 7", '7',
            (Q.match_pattern?('/u/<id>') && Q::MATCH[:id]))
      check("精确 pattern '/demo/u/7' 不命中", false, Q.match_pattern?('/demo/u/7'),
            'MAP_PATH 不含脚本自身位置')
    end
  end
end

