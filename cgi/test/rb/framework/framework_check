  check('require 后 Q::Form 可用', true, !defined?(Q::Form).nil?)
  check('require 后 Q::FormItem 可用', true, !defined?(Q::FormItem).nil?)

  cd = "form-data; name=\"f\"; filename=\"fallback.txt\"; filename*=UTF-8''%E6%8A%A5%E5%91%8A.txt"
  check('RFC5987 filename* 优先于 filename', '报告.txt',
        Q::FormItem.new({ 'Content-Disposition' => cd }, 'x').filename)
  check('去掉引号取 name', 'f',
        Q::FormItem.new({ 'Content-Disposition' => 'form-data; name="f"' }, 'x').name)
  check('有 filename → file? true', true,
        Q::FormItem.new({ 'Content-Disposition' => 'form-data; name="f"; filename="a.txt"' },
                        'x').file?)
  check('无 filename → file? false', false,
        Q::FormItem.new({ 'Content-Disposition' => 'form-data; name="f"' }, 'x').file?)
  check('#to_h 带 size', 3,
        Q::FormItem.new({ 'Content-Disposition' => 'form-data; name="f"' },
                        'abc').to_h[:size])
  check('#to_h 不含 content', false,
        Q::FormItem.new({ 'Content-Disposition' => 'form-data; name="f"' },
                        'abc').to_h.key?(:content))
  check('无 Content-Type 默认 text/plain', 'text/plain',
        Q::FormItem.new({ 'Content-Disposition' => 'form-data; name="f"' }, 'x').content_type)
  check('Form.parse 无 boundary 返回 nil', nil, Q::Form.parse(nil))
end

# ─────────────────────────────────────────────────────────────
# Notify: 用假子类测协议, 不开真 socket(避免占 5000 端口 / 留后台线程)
group 'notify' do
  require_relative 'notify_helper'

  cn = CaptureNotify.new('tester')
  cn.notify(:chat, 'hello')
  pkt = cn.sent.last
  check('notify 发出一个包', 1, cn.sent.size)

  hdr, body = cn.send(:split_packet, pkt)
  check('HEADER 与 PAYLOAD 用 \\n 分隔', true, pkt.include?("\n"))
  check('HEADER 以 k=msg 开头', true, hdr.start_with?('k=msg '))
  check('header 记录 kind=msg', 'msg', cn.send(:header_kv, hdr, :kind))
  check('header 记录 channel=chat', 'chat', cn.send(:header_kv, hdr, :channel))
  check('header 记录 name=tester', 'tester', cn.send(:header_kv, hdr, :name))
  check('header 记录 seq 递增', true, cn.send(:header_kv, hdr, :seq).to_i.positive?)
  check('header 记录 body_len=5', 5, cn.send(:header_kv, hdr, :body_len).to_i)
  check('payload 原样还原', 'hello', body)
  check('payload 是 ASCII-8BIT', Encoding::ASCII_8BIT, body.encoding)
  check('HEADER 是 ASCII-8BIT', Encoding::ASCII_8BIT, hdr.encoding)

  cn.notify(:chat, '报告')
  _, body_cn = cn.send(:split_packet, cn.sent.last)
  check('UTF-8 payload 字节数保持 6', 6, body_cn.bytesize)
  check('UTF-8 payload 可还原为原文', '报告', body_cn.force_encoding('UTF-8'))
  check('非法 UTF-8 字节不被替换成 U+FFFD(返回 hex 以免 JSON 序列化炸)', 'fffe',
        cn.send(:payload_bytes, "\xff\xfe").b.unpack1('H*'),
        '坑: encode! 会把非法字节变成 U+FFFD, 数据就毁了。' \
        '注: 直接把原始字节塞进 ok_json 会抛 JSON::GeneratorError, 断言输出须先 hex 化')
  check('payload nil → 空串', 0, cn.send(:payload_bytes, nil).bytesize)

  cn.notify(:chat, 'x', tag: 't1')
  hdr2, = cn.send(:split_packet, cn.sent.last)
  check('自定义 meta 进 HEADER, key 不缩写', 't1', cn.send(:header_kv, hdr2, 'tag'))

  over = "k=msg c=chat l=2\nABCDEF".dup.force_encoding(Encoding::ASCII_8BIT)
  _, trimmed = cn.send(:split_packet, over)
  check('split_packet 按 body_len 截断', 2, trimmed.bytesize)

  no_nl = 'k=msg c=chat'.dup.force_encoding(Encoding::ASCII_8BIT)
  h2, b2 = cn.send(:split_packet, no_nl)
  check('无 \\n 时整个包当 HEADER, payload 空', ['k=msg c=chat', 0], [h2, b2.bytesize])

  before = cn.sent.size
  cn.emit(:chat, 'e')
  check('emit 与无 block 的 notify 等价(各发一包)', before + 1, cn.sent.size)

  # dispatch 只投递给同 channel 的订阅者 —— 注意发包和订阅要用同一个 channel
  got = []
  cn.notify(:chat) { |m| got << m }
  cn.send(:dispatch_msg, cn.send(:parse_packet, pkt, '1.2.3.4:5'))
  check('notify(ch){} 收到自己发的', 1, got.size,
        'CRDT join 依赖这个 —— tool/editdoc/ws 显式回声就是为了它')

  got2 = []
  cn2 = CaptureNotify.new('tester2')
  cn2.notify(:chat, false) { |m| got2 << m }
  cn2.send(:dispatch_msg, cn2.send(:parse_packet, pkt, '1.2.3.4:5'))
  check('notify(ch, false){} 跳过自己发的', 0, got2.size)

  got3 = []
  cn3 = CaptureNotify.new('t3')
  cn3.notify(:chat, false) { |m| got3 << m }
  foreign = pkt.sub("p=#{Process.pid}", 'p=999999')
  cn3.send(:dispatch_msg, cn3.send(:parse_packet, foreign, '1.2.3.4:5'))
  check('notify(ch, false){} 收到别人的', 1, got3.size)

  gotx = []
  cnx = CaptureNotify.new('tx')
  cnx.notify(:other) { |m| gotx << m }
  cnx.send(:dispatch_msg, cnx.send(:parse_packet, pkt, '1.2.3.4:5'))
  check('只投递给同 channel 的订阅者', 0, gotx.size, 'pkt 的 channel 是 :chat')

  cn4 = CaptureNotify.new('t4')
  cn4.notify(nil, 'd')
  hdr4, = cn4.send(:split_packet, cn4.sent.last)
  check('nil channel 记为 default', 'default', cn4.send(:header_kv, hdr4, :channel))

  cn5 = CaptureNotify.new('t5')
  cn5.notify(:a) { nil }
  cn5.notify(:b) { nil }
  check('多 channel 独立订阅', %i[a b], cn5.instance_variable_get(:@subs).keys.sort)

  got6 = []
  cn6 = CaptureNotify.new('t6')
  cn6.notify(:chat) { raise 'subscriber boom' }
  cn6.notify(:chat) { |m| got6 << m }
  begin
    cn6.send(:dispatch_msg, cn6.send(:parse_packet, pkt, '1.2.3.4:5'))
  rescue StandardError
    nil
  end
  check('订阅者抛异常被吞掉且不中断后续订阅', 1, got6.size)

  check('stop 幂等(未 running 时直接返回 self)', true, cn6.stop.equal?(cn6))
  check('Notify 基类 do_send_packet 未实现', 'NotImplementedError',
        begin
          Class.new(Notify) { def initialize; super('x'); end }
                .new.tap { |n| n.send(:do_send_packet, 'x') }
          '(no exception)'
        rescue NotImplementedError
          'NotImplementedError'
        end)
end

# ─────────────────────────────────────────────────────────────
# 用 '/*' 而不是 '/': MAP_PATH 非空(restful 段存在)时也要能跑同一份断言,
# 这样同一脚本能被 /test/framework、/users/42、/demo/u/7 等 URL 分别驱动。
# method 同时挂 GET/POST —— POST 才能验到 req.body / body_json / body_form_data 分支。
Q.route '/*', method: %i[GET POST PUT] do |_req, rsp|
  failed = RESULTS.count { |r| !r[:ok] }
  rsp.ok_json(
    ok: failed.zero?,
    total: RESULTS.size,
    passed: RESULTS.size - failed,
    failed: failed,
    map_path: MAP,
    script: Q.script_name,
    results: RESULTS
  ).finish
end