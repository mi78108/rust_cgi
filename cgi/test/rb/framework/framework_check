    check('第二次 body 返回 nil(STDIN 已读干)', nil, req.body,
          '坑: body 只能读一次; 需要多次就自己缓存')
    check('body 读过后 body_json 返回 nil', nil, req.body_json)
    check('body 读过后 body_text 返回 nil', nil, req.body_text)
    check('body 读过后 STDIN 直读也是 nil', nil, STDIN.read(1024))
  end
end

