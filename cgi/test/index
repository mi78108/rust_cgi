# ============================================================
# 14c) StreamBody 三种构造方式演示
#   - Proc       (新建一个实例,proc 收 emit)
#   - StringIO   (IO 子类,each_chunk 按 BUFFER_SIZE 读)
#   - block 给 body( ) (BlockBody.new(&block))
# size 都未知 → finish 自动走 Transfer-Encoding: chunked
# ============================================================
Q.route '/demo/stream_body', method: :GET do |req, rsp|
  case req.param('kind', 'proc')
  when 'proc'
    # Proc: rsp.body(&proc)
    rsp.body( proc do |emit|
      3.times { |i| emit.call("proc-chunk-#{i}\n") }
    end).stream
  when 'stringio'
    # StringIO (IO 子类): rsp.body(StringIO.new(str))
    require 'stringio'
    data = "line1\nline2\nline3\n"
    rsp.body(StringIO.new(data)).stream(1).finish
  when 'block'
    # Block: rsp.body { |emit| ... }
    rsp.body { |emit,vv|
      4.times { |i| emit.call("block-chunk-#{i}\n") }
    }.stream 2
  else
    rsp.fail_400.type_text.body("kind must be one of: proc, stringio, block\n")
  end
end

