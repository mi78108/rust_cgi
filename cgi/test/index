end

# ============================================================
# 3) 命名捕获 + method_missing 糖（相对 Regexp 写法，自动加 /test/ 前缀）
# ============================================================
Q.route %r{^\/req_user/(?<id>\d+)$}, method: :GET do |req, rsp|
  rsp.ok_json(
    note:          '相对 regex (自动加 /test/ 前缀)',
    named_id_via_sym:   req.named(:id),     # 标准 symbol
    named_id_via_str:   req.named('id'),    # 也接受字符串
    named_id_via_sugar: req.named_id,       # method_missing: req.named_<name>
    argv_0:             req.argv(0),
    argv_0_via_sugar:   req.argv_0,         # method_missing: req.argv_<idx>
    param_user_or:      req.param_user || 'guest'  # method_missing: req.param_<key>
  ).finish
end

# 3a) 相对路径 "req_user2/<id>" —— 自动加 /test/ 前缀，<id> 转命名捕获
#     字符串含正则元字符或 <name> → 当 Regexp 解析
Q.route '/req_user2/<id>', method: :GET do |req, rsp|
  rsp.ok_json(
    note:      '相对路径 pattern（自动加 /test/ 前缀，<id> 转命名捕获）',
    id:        req.named(:id),
    id_sugar:  req.named_id
  ).finish
end

# 3b) Regexp 写法（自动加 /test/ 前缀，regex 写相对路径：^\/users/...）
#     ^ 和 $ 在外层用 \A/\z 统一包，pattern 内部写不写都行
#     但 / 必须显式写在相对路径里（与 string pattern 一致）
Q.route %r{^\/req_user3/(?<id>\d+)$}, method: :GET do |req, rsp|
  rsp.ok_json(
    note: '相对 Regexp 写法（自动加 /test/ 前缀）',
    id:   req.named(:id)
  ).finish
end

# 3b2) Regexp 写法（不带 ^/$ 锚点，外层 \A/\z 统一包也行）
Q.route %r{\/req_user4/(?<id>\d+)}, method: :GET do |req, rsp|
  rsp.ok_json(
    note: '相对 Regexp 不带锚点（外层 \A/\z 统一包）',
    id:   req.named(:id)
  ).finish
end

