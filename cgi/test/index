# frozen_string_literal: true
# test/index — Q._base_.rb 公共 API 测试 + 样例
#
# 路由 pattern 对照 Q::MAP_PATH（脚本 URL 之后的 restful 部分）：
#   Req_Path=/test             → MAP_PATH="/"        （restful 为空）
#   Req_Path=/test/info        → MAP_PATH="/info"
#   Req_Path=/test/u/42        → MAP_PATH="/u/42"
#   Req_Path=/test/demo/x/y    → MAP_PATH="/demo/x/y"
#
# 为避免和现有 demo path 冲突，所有 demo 加 /demo/ 前缀段。
#   pattern '/demo/info'       → 匹配 GET /test/demo/info
#   pattern %r{/demo/regex/(?<id>\d+)}  → 匹配 GET /test/demo/regex/42
#
# @<{}> 模板说明：render 把 eval 包在 Q.capture_stdout 里 —— 模板内
# puts/print 输出进 body；表达式返回值会被吞。
#   因此 demo 模板里的代码用 puts，不要依赖表达式返回值。
#   并且 @<{}> 内不能含 {}（gsub 找不到配对），用 do/end 或简单表达式。

