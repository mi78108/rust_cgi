# ============================================================
# 5) render + rsp.set — 两次注入
# ============================================================
Q.route '/render_set', method: :GET do |req, rsp|
  user   = req.param('user', 'guest')
  total  = (1..10).reduce(0) { |a, b| a + b }
  rsp.set(user: user, total: total)
  rsp.body(+'' << <<~HTML
    <h1>@{user}</h1>
    <p>1+2+...+10 = @{total}</p>
  HTML
  )
  rsp.render
  rsp.type_html.finish
end

# ============================================================
# 6) render_multiline — 多行 @{} 块（4 种场景）
# ============================================================
Q.route '/render_multiline', method: :GET do |_req, rsp|
  items = %w[apple banana cherry date]
  rsp.set(items: items)
  rsp.body(+'' << <<~'HTML'
    <!doctype html>
    <html><body>
      <h1>render_multiline demo</h1>

      <h2>1) if/else</h2>
      <pre>@{if items.size > 2
            'big list (' + items.size.to_s + ' items)'
          else
            'small list'
          end}</pre>

      <h2>2) map + join</h2>
      <ul>@{items.map { |n| '<li>' + n + '</li>' }.join}</ul>

      <h2>3) reduce + 字符串拼接</h2>
      <p>total chars: @{(items.map { |s| s.length }.reduce(0, :+)).to_s}</p>

      <h2>4) 嵌套块</h2>
      <table border="1">@{
        rows = items.map.with_index do |n, i|
          '<tr><td>' + (i + 1).to_s + '</td><td>' + n + '</td></tr>'
        end
        rows.join
      }</table>
    </body></html>
  HTML
  )
  rsp.render.type_html.finish
end

