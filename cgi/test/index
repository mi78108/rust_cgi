    ['GET',  '/fail_403',                  403, 'text/html'],
    ['GET',  '/fail_405',                  405, 'text/html'],
    ['GET',  '/fail_501',                  501, 'text/html'],
    ['GET',  '/stream',                    200, 'text/event-stream'],
    ['GET',  '/stream_max',                200, 'text/event-stream'],
    ['GET',  '/chunk',                     200, 'text/event-stream'],
    ['GET',  '/stream_sse',                200, 'text/event-stream'],
    ['GET',  '/hawk',                      200, 'text/event-stream'],
    ['GET',  '/download',                  200, nil],                # 由 send_file 设
    ['GET',  '/dual_methods',              200, 'application/json'],
    ['PUT',  '/dual_methods',              200, 'application/json'],
    ['POST', '/echo',                      200, 'application/json'],
    # /echo_json 需要传 application/json body
    ['POST', '/echo_json',                 200, 'application/json'],
    # /upload 需要传 multipart body（用 curl -F file=@xxx），裸 POST 返 400
    ['POST', '/upload',                    400, 'text/html'],
    ['GET',  '/sent',                      200, 'text/plain'],
    ['GET',  '/test/zzz_not_exist',        404, 'application/json'],  # 兜底
  ]
  out = +"<h1>QA — 复制下面命令验证</h1>\n<pre>BASE=http://127.0.0.1:3000\n"
  cases.each do |m, path, want_code, want_type|
    flag   = m == 'GET' ? '' : "-X #{m} "
    body_p = m == 'POST' ? " \\\n    -d 'hello=world'" : ''
    out << "curl -s -i #{flag}\"$BASE#{path}\"#{body_p}   # expect #{want_code}"
    out << (want_type ? " #{want_type}\n" : "\n")
  end
  # 单独说明 multipart
  out << "\n# /upload 需要传 multipart body:\n"
  out << "curl -s -i -X POST \"$BASE/test/upload\" -F file=@/etc/hostname\n"
  out << '</pre>'
  rsp.type_html.body(out).finish
end

