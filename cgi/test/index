  items = %w[apple banana cherry date]
  rsp.set(items: items)
  rsp.body(+'' << <<~'HTML')
    <!doctype html>
    <html><body>
      <h1>render_puts demo</h1>

      <h2>1) if/else</h2>
      <pre>@<{
        if items.size > 2
          puts "big list (" + items.size.to_s + " items)"
        else
          puts "small list"
        end
      }></pre>

      <h2>2) each + puts</h2>
      <ul>@<{
        items.each do |n|
