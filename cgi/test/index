# ============================================================
# 15) send_file — 静态文件下载
# ============================================================
Q.route '/download', method: :GET do |req, rsp|
  fn = req.param('fn', 'page.html')
  path = File.join(__dir__, fn)
  if File.readable?(path)
    rsp.send_file(path, download_as: File.basename(path))
  else
    rsp.fail_404.type_json.body({ error: 'no such file', tried: path }.to_json)
  end
  rsp.finish
end

