# ============================================================
# 17b) POST /echo_json — 演示 req.body_json 自动解析
#   curl -X POST $BASE/echo_json -H 'Content-Type: application/json' -d '{"x":1}'
# ============================================================
Q.route '/echo_json', method: :POST do |req, rsp|
  data = req.body_json   # 自动 rescue JSON::ParserError
  rsp.ok_json(
    parsed:       data,
    parsed_class: data.class.name,
    body_type:    req.body_type,
    body_length:  req.body_length,
    raw_head:     (req.body_text || '')[0, 200]   # 语义化别名，body 为空时给 ''
  ).finish
end

# ============================================================
# 18) POST /upload — multipart 上传
# ============================================================
Q.route '/upload', method: :POST do |req, rsp|
  form = req.body_form_data
  if form.nil?
    rsp.fail_400.type_html.body('expected multipart/form-data').finish
    next
  end
  saved = []
  form.each_file do |item|
    target = "/tmp/q_upload_#{Process.pid}_#{item.filename}"
    File.binwrite(target, item.content)
    saved << { name: item.name, filename: item.filename, to: target, size: item.content.bytesize }
  end
  rsp.ok_json(items: form.items.map(&:to_h), files_saved: form.files_count, saved: saved).finish
end

# ============================================================
# 19) finish 幂等 — 第二次 finish no-op
# ============================================================
Q.route '/sent', method: :GET do |_req, rsp|
  rsp.ok_text("first finish\n").finish
  rsp.finish                                          # 第一次 finish
  rsp.body('SECOND FINISH SHOULD NOT APPEAR')         # 设 body 但 finish 已发，不会再发
  rsp.finish                                          # 第二次 no-op (rsp.sent? == true)
end

