#!/usr/bin/env ruby
# frozen_string_literal: true
# test/index — Q._base_.rb 公共 API 测试 + 样例
#
# 路由 pattern 全部去 /test 前缀（脚本在 cgi/test/index，自动加 prefix /test）。
# pattern 写法：
#   '/info'           →  实际匹配 /test/info
#   '/users/<id>'     →  相对路径 + 命名捕获
#   %r{^\/users\/(?<id>\d+)$}  →  相对 Regexp（/ 必须显式写，^/$ 写不写都行）
#
# 所有 demo 在 GET / 列出（demo 路由 Q.route '/' 匹配 /test 本身）。
# GET /qa 输出所有 demo 的 curl 命令和期望 status/type，可以直接复制验证。
# 任何未匹配的路径走底部兜底：rsp.fail_404.type_json.body(...).finish。
#
# API 速查（与 _base_.rb 一一对应）：
#   路由:    Q.route pattern, method: :GET|:POST|[:GET,:PUT] do |req, rsp| ... end
#   HTTP method 快捷: Q.get / Q.post / Q.put / Q.delete / Q.patch / Q.head / Q.options
#   Pattern 匹配:
#     '/'                 脚本本身（/test）
#     '/info'             相对路径 → /test/info
#     '/users/<id>'       相对路径 + 命名捕获（<id> 转 (?<id>[^/]+)）
#     %r{^\/users\/(?<id>\d+)$}  相对 Regexp（自动加 prefix）
#     '/*'                脚本 prefix 下所有
#     nil                 兜底（总是匹配）
#   req 访问器（统一 (key, default=nil) 签名）:
#     req.method / path / query / body_type / body_length
#     req.argv(idx) / argv_count / named(name) / params / param(key)
#     req.header(name) / cookies / cookie(name) / body / body_json / body_text
#     req.body_form_data { |item| ... }
#     method_missing 糖: req.argv_0 / req.param_user / req.header_host / req.named_id / req.cookie_session
#   rsp 链式 (then-style sentinel, 0 参 = 读, 1 参 = 设):
#     rsp.code / status / body                    # 读: rsp.code;  设+链: rsp.code(200)
#     rsp.type / type_json / type_html / type_text / type_xml / type_bin(mime)
#     rsp.header (attr) / header_field / header_remove
#     rsp.cookie_set(name, value, max_age:, path:, httponly:, secure:, samesite:)
#     rsp.ok / ok_json / ok_html / ok_text / ok_xml
#     rsp.fail_400/403/404/405/500/501             # 链: rsp.fail_404.type_json.body(...)
#     rsp.redirect_to(loc, code: 302, body: '')
#     rsp.send_file(path, download_as:, mime:)
#     rsp.type_file(path, mime:, download_as:)      # 拆开 send_file 的 header 部分
#     rsp.set(hash) / render(**vars_hash)          # @{} 模板
#     rsp.stream { |n| n < 10 ? "..." : nil }      # 生成器风格, nil 终止
#     rsp.chunk { "..." }.chunk { "..." }          # 链式单 chunk
#     rsp.body(IO/path/block/string)               # Q::Body.wrap 智能识别
#     rsp.finish / sent?
#   Q 模块:
#     Q.script_name / basename / path / dir / cwd
#     Q.read / log / write
#     Q.on_close { ... }                          # 路由命中后、exit 0 之前回调

require_relative '../_base_'

Q.on_close do
  Q.log 'bye'
