# 13) chunk — 链式单 chunk，每调一次一个 frame
# ============================================================
Q.route '/chunk', method: :GET do |_req, rsp|
  rsp.chunk { "frame 1\n" }
     .chunk { "frame 2\n" }
     .chunk { "frame 3\n" }
