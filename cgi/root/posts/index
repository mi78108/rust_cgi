#!/usr/bin/env ruby
# frozen_string_literal: true
# root/posts/index — posts 子模块入口
#   GET /                          → SPA HTML (dist/index.html)  ← 这里
# 其他路由按端点拆到独立文件 (list / tags / get / create / update / assets)。

require_relative '../../_env_/ruby/_base_'

SPA_FILE = 'dist/index.html'

Q.get '/*' do |_req, rsp|
  if File.file?(SPA_FILE)
    rsp.type('text/html; charset=utf-8').body(File.read(SPA_FILE)).finish
  else
    rsp.fail_404.type_html.body("SPA not built: #{SPA_FILE}").finish
  end
end

Q.route do |_req, rsp|
  rsp.code(404).status('Not Found').type_json.body({ error: "posts route not found", code: 404, path: Q::REQ_PATH }.to_json).finish
end