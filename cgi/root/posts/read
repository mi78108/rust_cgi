#!/usr/bin/env ruby
# frozen_string_literal: true
# root/posts/read — GET /root/posts/read/<slug>
#
# 独立阅读页 (单链 URL):
#   https://.../root/posts/read/<slug>
# 后端只 SSR <title>/<meta>/<header>; 正文/编辑/分页都走客户端 posts.js 接管。
#
# 模板 posts/static/read.html + 下面的渲染函数都归posts 所有;
# /root/notes/read 是独立的一套 (后续两者样式/导航会分叉, 不共用)。

require_relative File.expand_path('../../_base_', __dir__)
require_relative '_lib'

READ_TPL = File.expand_path('static/read.html', __dir__)

def esc_html(s)
  String(s).gsub(/[&<>"']/) { |c| { '&'=>'&amp;','<'=>'&lt;','>'=>'&gt;','"'=>'&quot;',"'"=>'&#39;' }[c] }
end

def excerpt_from_body(body)
  String(body.to_s)[0, 160].gsub(/[#>*_`\-\n]/, ' ').squeeze(' ').strip
end

def render_read_page(slug:, title:, excerpt:)
  fields = {
    'TITLE'    => esc_html(title),
    'EXCERPT'  => esc_html(excerpt),
    'SLUG'     => esc_html(slug),
    'KIND'     => 'posts',
    'ASSET_JS' => '/root/posts/assets/posts.js',
  }
  File.read(READ_TPL, encoding: 'utf-8').gsub(/{{(\w+)}}/) { fields.fetch($1) }
end

def render_404_page(slug)
  esc = esc_html(slug)
  "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>404 · #{esc}</title>" \
    "<style>body{font-family:ui-monospace,monospace;padding:40px;background:#f4f1de;color:#0f0f12}</style>" \
    "</head><body><h1>404 · posts not found</h1><p>slug: <code>#{esc}</code></p>" \
    "<p><a href=\"/root/posts\">← /root/posts</a></p></body></html>"
end

Q.get(%r{^/(?<slug>[^/]+)$}) do |req, rsp|
  slug = req.named(:slug)
  post = find_post(slug)
  if post.nil?
    rsp.code(404).status('Not Found').type('text/html; charset=utf-8').body(render_404_page(slug)).finish
    next
  end

  html = render_read_page(
    slug:    slug,
    title:   post[:title],
    excerpt: excerpt_from_body(post[:body]),
  )
  rsp.type('text/html; charset=utf-8').body(html).finish
end