#!/usr/bin/env ruby
# frozen_string_literal: true
# root/posts/list — GET /root/posts/list
#
# 路由只做: 取全量 → 序列化 → 包响应。业务在 Post / Post::Api。

require_relative File.expand_path('../../_base_', __dir__)
require_relative '_lib_'

Q.get '/*' do |_req, rsp|
  list = Post.list.map { |p| Post::Api.serialize(p) }
  rsp.ok_json({ ok: true, data: {
    posts: list, count: list.size, generated_at: Time.now.utc.iso8601
  } }).finish
end
