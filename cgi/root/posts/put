#!/usr/bin/env ruby
# frozen_string_literal: true
# root/posts/put — 更新
#
#   PUT /root/posts/put/<slug> → body: { title?, body?, summary?, tags? }

require_relative '../../_env_/ruby/_base_'
require_relative '_lib_'

Q.put(%r{^/(?<slug>.+)$}) do |req, rsp|
  # next unless require_write_auth(req, rsp)
  slug = req.named(:slug)
  data = Post::Api.parse_body(req)
  if data.nil?
    rsp.code(400).status('Bad Request').ok_json({ ok: false, error: 'invalid json' }).finish
    next
  end

  result = Post.update(slug: slug, **Post::Api.write_params(data))
  unless result[:ok]
    code = result[:error] == 'not found' ? 404 : 400
    rsp.code(code).status(code == 404 ? 'Not Found' : 'Bad Request')
       .ok_json({ ok: false, error: result[:error] }).finish
    next
  end

  post = Post.find(slug)
  rsp.ok_json({ ok: true, data: Post.with_prev_next(slug, post) }).finish
end
