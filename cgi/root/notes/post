#!/usr/bin/env ruby
# frozen_string_literal: true
# root/notes/post — 创建
#
#   POST /root/notes/post/new   → 创建 (body: {slug?, title, body, author?, tags})

require_relative File.expand_path('../../_base_', __dir__)
require_relative '_lib'

Q.post '/new' do |req, rsp|
  data = JSON.parse(req.body.to_s, symbolize_names: true) rescue {}
  result = create_note(data)
  if result[:ok]
    note = find_note(result[:slug])
    rsp.ok_json({ ok: true, data: with_prev_next(result[:slug], note) }).finish
  else
    rsp.code(400).status('Bad Request').ok_json({ ok: false, error: result[:error] }).finish
  end
end