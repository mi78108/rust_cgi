#!/usr/bin/env ruby
# frozen_string_literal: true
# root/notes/list — GET /root/notes/list

require_relative File.expand_path('../../_base_', __dir__)
require_relative '_lib'

Q.get '/all' do |_req, rsp|
  list = all_notes.map { |n| serialize_list(n) }
  rsp.ok_json({ ok: true, data: { notes: list, count: list.size, generated_at: Time.now.utc.iso8601 } }).finish
end