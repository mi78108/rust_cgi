#!/usr/bin/env ruby
# frozen_string_literal: true
# root/notes/spa — SPA 入口 (GET /)

require_relative File.expand_path('../../_base_', __dir__)

SPA_FILE = File.expand_path('static/index.html', __dir__)

Q.get '/' do |_req, rsp|
  if File.file?(SPA_FILE)
    rsp.type('text/html; charset=utf-8').body(File.read(SPA_FILE)).finish
  else
    rsp.fail_404.type_html.body("SPA not built: #{SPA_FILE}").finish
  end
end