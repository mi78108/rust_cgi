#!/usr/bin/env ruby
# frozen_string_literal: true
# root/notes/put — 更新
#
#   PUT /root/notes/put/<slug>  → 更新 (body: {title?, body?, author?, tags?})

require_relative File.expand_path('../../_base_', __dir__)
require_relative '_lib'

Q.put(%r{^/(?<slug>[^/]+)$}) do |req, rsp|
  slug = req.named(:slug)
  data = JSON.parse(req.body.to_s, symbolize_names: true) rescue {}
  result = update_note(slug, data)
  if result[:ok]
    note = find_note(slug)
    rsp.ok_json({ ok: true, data: with_prev_next(slug, note) }).finish
  else
    code = result[:error] == 'not found' ? 404 : 400
    rsp.code(code).status(code == 404 ? 'Not Found' : 'Bad Request').ok_json({ ok: false, error: result[:error] }).finish
  end
end