#!/usr/bin/env ruby
# frozen_string_literal: true
# root/index — 主站入口
#
#   GET /        → 渲染 root/page.html
#   GET /ws      → 101 Switching Protocols (ws handshake, 走 Q.ws)
#
# 业务逻辑全部抽到 _ws_lib.rb, 这里只做框架接线.
#
# spider 是 fork-per-request (每个请求一个 ruby 子进程), 所以本进程只会
# 服务一个 ws 连接, 进程内单例 mcast / $peers 不会跨连接泄漏.

require_relative '../_base_'
require_relative '../_ext_notify_'
require_relative '_ws_lib'

# 老 Q.notify_fs('root', data) / Q.notify_fs(...) do |content, list| ... end
# 已迁到 SocketNotify.emit + notify block:
#   - 老 "list = 同 channel 所有 token 文件路径" 换成 in-memory $peers hash
#     (msg.id => parsed self_user), callback 收到 self_user 时写入.
#   - 老 "info = 自己 token 路径, File.write(info, ...)" 换成直接 emit self_user
#     (别的 peer 收到时记进它的 $peers[id]).
# SocketNotify 没 connect, 自身 emit 会被自己收到 (self-loop),
# callback 里按 pid 跳过.

$peers = {}  # msg.id ("host:pid") => parsed self_user hash

# ── GET / → 主页面 ───────────────────────────────────
Q.get '/' do |_req, rsp|
  if File.exist?('page.html')
    rsp.type_html.body(File.read('page.html')).render.finish
  else
    rsp.fail_404.type_html.body(ENV.to_a.to_json).finish
  end
end

# ── WebSocket 入口 ─────────────────────────────────────
Q.ws do |req|
  mcast = nil
  begin
    mcast = SocketNotify.new("cgi-#{Process.pid}-root")
    mcast.notify(:root) do |msg|
      next if msg.pid.to_i == Process.pid  # 自我回环跳过
      val = JSON.parse(msg.text) rescue nil
      next unless val.is_a?(Hash)
      if val['opt'] == 'refresh'
        # 老: users = list.map { |v| JSON.parse(File.read(v)) }
        # 新: $peers.values
        users = $peers.values
        Q.write({ type: 'update', data: users }.to_json)
      else
        # val 是 self_user 状态, 记进 $peers
        $peers[msg.id] = val
      end
    end
  rescue => e
    Q.log("[root/ws] notify bind fail (this proc sends only): #{e.message}")
  end
  # 老 Q.notify_fs('root', {opt:'refresh'}.to_json) — 通知别进程刷
  mcast&.emit(:root, { opt: 'refresh' }.to_json)
  Q.log("[root/ws] + new client")

  # 老 Q.notify_fs('root', $self_user.to_json) do |content, list| ... end
  # 等价: 立即 emit self_user (别的 peer 收到时记进 $peers[id]) — refresh
  # listener 已在上面 ensure_mcast 里注册.
  mcast&.emit(:root, $self_user.to_json)

  # 4) server-side 心跳 (15s/次) + 系统快照 (5s/次)
  Thread.new do
    loop do
      sleep HEARTBEAT
      begin
        Q.write({ type: 'ping', ts: Time.now.to_i }.to_json)
      rescue
        break
      end
    end
  end

  # 5) frame 循环
  # 原代码用 Q.read { |chunk| ... } 持续阻塞读 STDIN; 新版 req.on_data 在
  # Req 内 readpartial + 循环到 EOF, block 返回 nil 时不自动 write, 保留
  # 老代码内部显式 Q.write 的语义.
  req.on_ws_data do |chunk|
    Q.log "VVVVVVVVVVVVVVVVV   #{chunk}"
    chunk.force_encoding('utf-8')
    msg = begin
            ; JSON.parse(chunk);
          rescue;
            nil;
          end
    next nil unless msg.is_a?(Hash)
    result = ws_handle_frame(msg)
    case result
    when :pong
      if msg['op'] == 'pong'
        # 客户端回 pong, 附送当前 system snapshot 一次 (降低前端等 system 推送的延迟)
        Q.write({ type: 'pong', ts: Time.now.to_i, system: ws_system_snapshot }.to_json)
      else
        Q.write({ type: 'pong', ts: Time.now.to_i }.to_json)
      end
    when :hello
      mcast&.emit(:root, { opt: 'refresh' }.to_json)
      Q.write({ type: 'hello', ts: Time.now.to_i }.to_json)
    when :subscribe, :unsubscribe
      # 占位: 未来可加 channel 订阅
    when :publish
      Q.log("[root/ws] client publish, op=publish (echo only)")
    when :renamed
      # 老: _, info = Q.notify_fs('root', {opt:'refresh'}.to_json)
      #     File.write(info, $self_user.to_json)
      # 新: emit refresh + emit self_user (别进程 refresh 时会把 $peers
      # 序列化推给客户端, 看到自己的新名字)
      mcast&.emit(:root, { opt: 'refresh' }.to_json)
      mcast&.emit(:root, $self_user.to_json)
    when :bad_name
      Q.write({ type: 'error', msg: 'invalid name (1-20 chars [a-z0-9_-])' }.to_json)
    when :unknown
      Q.write({ type: 'error', msg: "unknown op: #{msg['op']}" }.to_json)
    end
    nil
  rescue => e
    Q.log("[root/ws] recv err: #{e.message}")
  end

  # 6) 客户端断开 (Q.recv EOF) — 清理 + 跨进程广播 leave
  mcast&.emit(:root, { opt: 'refresh' }.to_json)

end
