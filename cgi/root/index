#!/usr/bin/env ruby
# frozen_string_literal: true
# root/index — 主站入口
#
#   GET /        → 渲染 root/page.html
#   GET /ws      → 101 Switching Protocols (ws handshake, 走 Q.ws)
#
# 业务逻辑全部抽到 _ws_lib.rb, 这里只做框架接线.
#
# spider 是 fork-per-request (每个请求一个 ruby 子进程), 所以本进程只会
# 服务一个 ws 连接, 进程内单例 mcast / $peers 不会跨连接泄漏.

require_relative '../_base_'
require_relative '../_ext_notify_'
require_relative '_ws_lib'

# ── GET / → 主页面 ───────────────────────────────────
Q.get '/' do |_req, rsp|
  if File.exist?('page.html')
    rsp.type_html.body(File.read('page.html')).render(v:ws_system_snapshot)
  else
    rsp.fail_404.type_html.body(ENV.to_a.to_json).finish
  end
end

# ── WebSocket 入口 ─────────────────────────────────────
Q.ws do |req|
  PEER = {}
  mcast = SocketNotify.new("cgi-#{Process.pid}-root")
  mcast.notify(:root, false) do |msg|
    # false = 不回环，跳过自己发的
    # msg.data 是 ASCII-8BIT bytes，JSON 解析要先转回 UTF-8
    val = JSON.parse(msg.data.force_encoding('UTF-8')) rescue nil
    next unless val.is_a?(Hash)
    if val['opt'] == 'refresh'
      if val['value'].nil?
        mcast.notify(:root, { opt: 'refresh', value: {name: @user_name} }.to_json)
      else
        PEER[val['value']['name']] = val['value']
        Q.write({ type: 'update', data: PEER.values }.to_json)
      end
    end
    if val['opt'] == 'up' or val['opt'] == 'down'
      next if val['value'].nil?
      PEER[val['value']['name']] = val['value'] if val['opt'] == 'up'
      PEER.delete(val['value']['name']) if val['opt'] == 'down'
      Q.write({ type: 'update', data: PEER.values }.to_json)
    end
  end

  Q.log("[root/ws] + new client")
  Q.on_close do
    mcast.notify(:root, { opt: 'down', value: {name: @user_name} }.to_json)
  end

  req.on_ws_data do |chunk|
    begin
      msg = JSON.parse(chunk.force_encoding('utf-8'))
      next nil unless msg.is_a?(Hash)
      Q.log "ON WS #{msg}"
      rsp = case msg['op']
            when 'set-name'
              @user_name = msg['name']
              mcast.notify(:root, { opt: 'up',value: {name: @user_name} }.to_json)
              mcast.notify(:root, { opt: 'refresh' }.to_json)
              Q.log "Set Name: #{@user_name}"
              { type: 'set_name', ts: Time.now.to_i }.to_json
            when 'hello'
              { type: 'hello', ts: Time.now.to_i }.to_json
            when 'ping'
              { type: 'system',value: ws_system_snapshot }.to_json
            else
              { type: 'error', msg: "unknown msg #{chunk}" }.to_json
            end
      sleep(0.1)
      Q.write(rsp, true) unless rsp.nil?
    rescue => e
      Q.log("[root/ws] recv err: #{e.message}")
    end
    nil
  end
  mcast.notify(:root, { opt: 'down' }.to_json)
end
