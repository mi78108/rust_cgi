#!/usr/bin/env ruby

require 'securerandom'
require "sqlite3"
require 'mime/types'
require_relative '../../_init_'
$db = SQLite3::Database.new "#{ENV['HOME']}/Documents/website/website.db"
$dist = "#{ENV['HOME']}/Documents/website/dist"
$db.results_as_hash = true

$db.execute <<-SQL
  CREATE TABLE IF NOT EXISTS posts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    rid INTEGER NOT NULL,
    title TEXT,
    content TEXT,
    content_html TEXT,
    status TEXT,
    created_at DATETIME DEFAULT (datetime('now', '+8 hour')),
    updated_at DATETIME DEFAULT (datetime('now', '+8 hour'))
  );
SQL

$db.execute <<-SQL
  CREATE TABLE IF NOT EXISTS resource (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    rid INTEGER NOT NULL,
    content TEXT,
    status TEXT,
    created_at DATETIME DEFAULT (datetime('now', '+8 hour')),
    updated_at DATETIME DEFAULT (datetime('now', '+8 hour'))
  );
SQL

Q.map(:POST, "/upload") do |req, resp|
  v = req.body_form_data.items.map do |item|
    ctx = item.content.join
    ext = File.extname(item.header['filename'])
    new_filename = SecureRandom.uuid + ext
    File.write("#{$dist}/#{new_filename}", ctx)
    $db.execute("INSERT INTO resource (rid, content, status) VALUES (?, ?, ?)", [req.param_rid, new_filename,0] );
    new_filename
  end
  resp.ok_json(v).finally
end

Q.map(:POST, "/post") do |req, resp|
  ctx =  JSON.parse(req.body)
  $db.execute("INSERT INTO posts (rid, title, content, content_html, created_at) VALUES (?, ?, ?, ?, ?)", [0, ctx['title'], ctx['content'], ctx['content_html'], ctx['created_at'] || Time.now.to_s])
  id = $db.last_insert_row_id
  $db.execute("UPDATE resource set rid = ?, status=1 WHERE rid=?", [id, req.param_rid])
  resp.ok_json({:opt => "ok", :val=> id}).finally
end

Q.map(:PUT, "/post") do |req, resp|
  ctx =  JSON.parse(req.body)
  rid = req.param_rid
  $db.execute("UPDATE posts SET rid=?, title=?, content=?, content_html=?, updated_at=? WHERE id =?", [rid, ctx['title'], ctx['content'], ctx['content_html'], Time.now.to_s, rid])
  id = $db.last_insert_row_id
  resp.ok_json({:opt => "ok", :val=> id}).finally
end
