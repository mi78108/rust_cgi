Q.map(:GET, %r{/(?<rid>\d+)/version}) do |req, resp|
  rid = req.match[:rid]
  versions = $db.execute("SELECT * FROM posts WHERE id=?", [rid])
  find_child = Proc.new do |current_id|
    children = $db.execute("SELECT * FROM posts WHERE rid = ?", [current_id])

    result = children.dup
    children.each do |child|
      result += find_child.call(child['id'])
    end
    result
  end
  versions += find_child.call(rid)
  resp.html('./version.html').render do |v|
    v.versions = versions
  end.finally
end

Q.map(:GET, %r{/(?<rid>\d+)/content}) do |req, resp|
  art = $db.execute("SELECT * FROM posts WHERE id = ?", [req.match[:rid]]).first
  resp.ok_html(art['content_html']).finally
end

Q.map :DELETE do |req, resp|
  id = req.argv_0
  count = 0
  $db.execute("DELETE  FROM posts WHERE id = ?", [id])
  $db.execute("SELECT * FROM resource WHERE rid = ?", [id]).each do |fs|
    File.delete("./dist/#{fs['content']}")
    count += 1
  end
  $db.execute("DELETE  FROM resource WHERE rid = ?", [id])
  resp.ok_json({:opt => "ok", :val => count}).finally
end

Q.map :GET do |req, resp|
  rid = req.argv_0
  art = rid.nil? ? [] : $db.execute("SELECT * FROM posts WHERE id = ?", [rid])
  art = art.size.zero? ? {} : art.first
  rid = ("T" + SecureRandom.uuid) if rid.nil?
  resp.html.render do |v|
    v.rid = rid
    v.art = art
  end.finally
end


Q.map do |_, r|
  r.fail_404 ENV.to_a.to_json
end
