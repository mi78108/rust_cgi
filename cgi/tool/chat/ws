#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/chat/ws — 在线聊天室 WebSocket 端点
#
#   WS /tool/chat/ws
#
# 架构（单主机多进程，靠 SocketNotify UDP 组播跨 fork 的 CGI 子进程）:
#   浏览器 A ──ws──> ruby 进程 A ─┐
#                                 ├─ SocketNotify 组播 channel :chat-<room>
#   浏览器 B ──ws──> ruby 进程 B ─┘
#
# 每个连接一个 ruby 进程（fork-per-request），各自持有:
#   @room    当前房间名（client 发 join 时定）
#   @peer    {name:, color:}
#   @peers   房内已知 peer 缓存（从别的进程的 join/up/down 广播累积）
#
# 协议 (JSON text):
#   client → server
#     {op:'join',  name, color, room}    切房间（会先 leave 旧房间）
#     {op:'msg',   text}
#     {op:'leave'}
#   server → client
#     {type:'init',  you, peers}        join 后回（自己的身份 + 已知 peer）
#     {type:'msg',   from, color, text, ts}
#     {type:'join',  peer}              别人进来了
#     {type:'leave', name}              别人走了
#     {type:'peers', peers}             房内 peer 全量（refresh 回应）
#     {type:'error', msg}

require_relative '../../_env_/ruby/_base_'
require_relative '../../_env_/ruby/_ext_notify_'

# 单条消息长度上限（防止有人狂刷）
MSG_MAX     = 4 * 1024
NAME_MAX    = 32
ROOM_MAX    = 32
PEER_TTL    = 30   # 秒，refresh 超时

Q.ws do |req, rsp|
  myname   = nil
  mycolor  = nil
  room     = nil
  chan     = nil
  peers    = {}          # name => {name:, color:}

  mcast = SocketNotify.new("cgi-chat-#{Process.pid}")

  # 收别的进程广播的房内消息
  mcast.notify(:default) do |msg|
    next if msg.pid.to_i == Process.pid
    next if chan.nil?
    next unless msg.channel == chan

    val = JSON.parse(msg.data.force_encoding('UTF-8')) rescue nil
    next unless val.is_a?(Hash)

    case val['op']
    when 'msg'
      rsp.ws_write({ type: 'msg', from: val['from'], color: val['color'],
                     text: val['text'], ts: val['ts'] }.to_json)
    when 'up'
      p = val['peer']
      if p.is_a?(Hash) && p['name'] != myname
        peers[p['name']] = p
        rsp.ws_write({ type: 'join', peer: p }.to_json)
      end
    when 'down'
      n = val['name'].to_s
      if peers.delete(n)
        rsp.ws_write({ type: 'leave', name: n }.to_json)
      end
    when 'who'
      # 有人问房内都有谁（新人加入时问一圈）→ 回一份全量
      mcast.notify(chan, { op: 'peers', peers: peers.values }.to_json)
    when 'peers'
      # 别人回应了 who's询问
      incoming = Array(val['peers']).select { |x| x.is_a?(Hash) && x['name'] != myname }
      known = peers.keys
      incoming.each do |p|
        next if known.include?(p['name'])
        peers[p['name']] = p
        rsp.ws_write({ type: 'join', peer: p }.to_json)
      end
    end
  end

  Q.log('[chat/ws] + client')

  Q.on_close do
    if chan && myname
      mcast.notify(chan, { op: 'down', name: myname }.to_json)
    end
    mcast.stop
    Q.log('[chat/ws] - client')
  end

  req.on_ws_data do |chunk|
    begin
      msg = JSON.parse(chunk.force_encoding('UTF-8'))
      next nil unless msg.is_a?(Hash)

      case msg['op']
      when 'join'
        new_room = msg['room'].to_s.strip.gsub(/[^A-Za-z0-9_-]/, '')[0, ROOM_MAX] || 'default'
        new_room = 'default' if new_room.empty?
        new_name = msg['name'].to_s.strip.gsub(/[^A-Za-z0-9_-]/, '')[0, NAME_MAX]
        new_name = "anon-#{Process.pid % 10000}" if new_name.empty?
        new_color = msg['color'].to_s.gsub(/[^0-9A-Fa-f#]/, '')[0, 9]
        new_color = '#c4f542' if new_color.empty?

        # 退旧房间
        if chan && myname && chan != "chat-#{new_room}".to_sym
          mcast.notify(chan, { op: 'down', name: myname }.to_json)
        end

        myname  = new_name
        mycolor = new_color
        room    = new_room
        chan    = "chat-#{room}".to_sym

        # 把自己加进本地 peer 缓存
        peers[myname] = { name: myname, color: mycolor }

        # 广播我来了
        mcast.notify(chan, { op: 'up', peer: peers[myname] }.to_json)

        # 回 init（你 + 当前已知 peer，稍后 who's 会补全）
        rsp.ws_write({ type: 'init', you: { name: myname, color: mycolor }, peers: peers.values }.to_json)

        # 问一圈房内都有谁（只发一次，避免回环风暴）
        mcast.notify(chan, { op: 'who', from: myname }.to_json)

      when 'msg'
        next nil unless chan && myname
        text = msg['text'].to_s.strip
        next nil if text.empty?
        text = text[0, MSG_MAX] if text.bytesize > MSG_MAX
        now = Time.now.to_i
        mcast.notify(chan, { op: 'msg', from: myname, color: mycolor,
                             text: text, ts: now }.to_json)
        # 自己也要看到（SocketNotify 不回环）
        rsp.ws_write({ type: 'msg', from: myname, color: mycolor,
                       text: text, ts: now }.to_json)

      when 'leave'
        if chan && myname
          mcast.notify(chan, { op: 'down', name: myname }.to_json)
        end

      when 'ping'
        rsp.ws_write({ type: 'error', msg: 'pong' }.to_json)
      end

    rescue => e
      Q.log("[chat/ws] recv err: #{e.message}")
    end
    nil
  end
end