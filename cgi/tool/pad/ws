#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/pad/ws — 协作编辑 WebSocket 端点（自实现 RGA CRDT）
#
#   WS /tool/pad/ws
#
# 服务器持有**权威状态** —— 不是纯转发（早期版本是纯转发，
# 文档状态散在各客户端，靠 CASPaxos 共识同步成员表）。
#
# 服务器做三件事：
#   1. 持有文档 op log（文件），新客户端连上时发全量
#   2. 收到 op → 追加到 log → 广播给其他客户端
#   3. 维护成员表（每客户端一个文件，谁在线 = 目录里有哪些文件）
#
# 协议（JSON over WS text frame）：
#
#   客户端 → 服务器
#     {"t":"hello","name":"user-ab12","color":"#c4f542"}
#     {"t":"op","op":{"t":"i","id":["c1",3],"v":"A","l":["c1",2]}}
#     {"t":"presence","cursor":42}
#     {"t":"sync"}
#
#   服务器 → 客户端
#     {"t":"hello-ack","id":"c2665723_3f2a9b1c"}   // 服务端分配的 id
#     {"t":"ops","ops":[...],"total":13}
#     {"t":"members","members":[{"id":..,"name":..,"color":..,"cursor":..}]}
#
# ★ id 只有一套 —— 服务端分配，同时当 CRDT 身份和成员表身份。
#   客户端拿到它之前不算初始化成功（不能生成 op，id 会是 [null, seq]）。
#
# 为什么用 JSON 而不是二进制：
#   这个规模（几百字节文档）下带宽开销可忽略，换来可调试（curl 能看懂）
#   + 不用写编解码器。RGA op 数 = 每次按键一个，长文档会涨，demo 阶段够用。
#
# 状态目录：
#   $SPIDER_DATA/pad/<docId>/ops.log        每行一个 op (JSON)，只追加
#   $SPIDER_DATA/pad/<docId>/members/<cid>.json  每个客户端一份
#
# 广播用 TcpNotify（TCP 长连接，BDR 协议），连的是 spider 自己的监听端口
# （靠 magic 探测分流到 tcp_broadcast）。跨进程 —— 因为 spider 是
# fork-per-request，每个 ws 连接一个 ruby 进程，进程间不共享内存。
#
# 为什么不用 SocketNotify（UDP 组播）：
#   BDR 由**服务端**做扇出，语义更可控（有序、可靠、不丢包）。
#   UDP 组播是"人人发人人收"，客户端多的时候会有 N² 的流量，而且
#   组播不回环 —— 发送方要单独补发一份自己（代码里到处 rsp.ws_write），
#   逻辑容易漏。
#
#   ★ BDR 的回环语义：spider 广播给频道里**所有**订阅者，**包括发送者自己**。
#     所以这里 want_echo=false（跳过自己发的），自己那份仍然走 rsp.ws_write。

require_relative '../../_env_/ruby/_base_'
require_relative '../../_env_/ruby/_ext_notify_'
require 'json'
require 'fileutils'
require 'securerandom'

# ── 配置 ────────────────────────────────────────────────────
PAD_ROOT = ENV.fetch('SPIDER_DATA', '').empty? ? '/tmp/pad' : ENV['SPIDER_DATA']
DOC_ID   = 'default'

DOC_DIR  = File.join(PAD_ROOT, DOC_ID)
OPS_LOG  = File.join(DOC_DIR, 'ops.log')
MEM_DIR  = File.join(DOC_DIR, 'members')

# BDR 频道名 —— 所有 pad 客户端共用一个
PAD_CHANNEL = 'pad'

# 成员心跳间隔：超过这个时间没更新就认为掉线了
MEMBER_TTL = 30

# 单条 op 最大字节（防呆）
MAX_OP_BYTES = 64 * 1024

FileUtils.mkdir_p(MEM_DIR)

# ── op log ──────────────────────────────────────────────────
# 只追加，一行一个 JSON op。并发 append 在 POSIX 下对 < PIPE_BUF 的写入
# 是原子的，但为了稳妥还是加锁（每个进程一把自己的锁 + flock 文件锁）。

def log_lock
  @log_lock ||= begin
    File.open(OPS_LOG, File::WRONLY | File::CREAT | File::APPEND)
  end
end

# 已写入 op 的 id 集合 —— 防止重复追加。
# 客户端重连时会把 pending 队列里的 op 补发，那些 op 服务器可能已经收过，
# 再追加一遍会撑爆 log（内容重复虽然 CRDT 幂等不出错，但很难看）。
#
# 键必须带 op 类型 —— 插入 op 和删除 op 指向同一个节点 id，
# 但它们是两个不同的操作。只用 id 去重会把删除 op 当成重复而丢掉。
def op_seen_set
  @op_seen ||= begin
    s = {}
    File.foreach(OPS_LOG) do |line|
      line = line.strip
      next if line.empty?
      begin
        op = JSON.parse(line)
        id = op['id']
        next unless id.is_a?(Array) && id.size == 2
        s["#{op['t']}:#{id[0]}:#{id[1]}"] = true
      rescue JSON::ParserError
        next
      end
    end
    s
  end
end

def append_op(op)
  line = JSON.generate(op)
  return false if line.bytesize > MAX_OP_BYTES
  id = op['id']
  return false unless id.is_a?(Array) && id.size == 2
  # id[0] 必须是**非空字符串** —— 客户端没收到 hello-ack 时会生成 [null, seq]，
  # 这种 op 写进 log 会污染所有客户端的 CRDT（别人收到 null id 的节点）。
  # 前端有 initialized 门控挡着，但服务端也要兜底 —— 不能指望客户端永远正确。
  return false unless id[0].is_a?(String) && !id[0].empty?
  return false unless id[1].is_a?(Integer)
  # 键带 op 类型 —— 插入/删除指向同一个 id 时不能互相误判为重复
  key = "#{op['t']}:#{id[0]}:#{id[1]}"

  log_lock.flock(File::LOCK_EX)
  begin
    # 重复的 op 不再追加（CRDT 幂等，重复应用无害，但 log 会膨胀）
    return false if op_seen_set.key?(key)
    log_lock.write(line + "\n")
    log_lock.flush
    op_seen_set[key] = true
  ensure
    log_lock.flock(File::LOCK_UN)
  end
  true
rescue => e
  Q.log "[pad/ws] append failed: #{e.class}: #{e.message}"
  false
end

def read_ops
  return [] unless File.exist?(OPS_LOG)
  out = []
  File.foreach(OPS_LOG) do |line|
    line = line.strip
    next if line.empty?
    begin
      out << JSON.parse(line)
    rescue JSON::ParserError
      # 半行（写了一半）→ 跳过
    end
  end
  out
end

# ── 成员表 ─────────────────────────────────────────────────
# 每个客户端一个文件，避免多进程互相覆盖。
# 谁在线 = members/ 目录里有哪些文件。

# 生成客户端 id —— 同时用作 **CRDT 身份** 和 **成员表身份**。
#
# 格式: c{pid}_{8位随机十六进制}
#   例: c2665723_3f2a9b1c
#
#   · 固定前缀 'c' + 数字 pid + '_' + 定长随机 → 字典序可比
#     (compareId 用 a[0] < b[0] 字符串比较，所以随机部分必须定长，
#      否则 "c1_a" > "c1_bb" 这种长度不齐的比较没有稳定含义)
#   · pid 便于排查（日志里一眼看出是哪个 CGI 进程发的）
#   · 随机后缀保证全局唯一 —— 单靠 pid 不够：
#     多机部署时两台机器的 pid 可能撞，同 pid 再加同秒就会生成同 id
#     → seq 冲突 → op 被误判重复而丢失
def new_client_id
  "c#{Process.pid}_#{SecureRandom.hex(4)}"
end

def member_file(cid)
  File.join(MEM_DIR, "#{cid}.json")
end

def write_member(cid, info)
  FileUtils.mkdir_p(MEM_DIR)
  tmp = member_file(cid) + '.tmp'
  File.write(tmp, JSON.generate(info))
  File.rename(tmp, member_file(cid))   # 原子替换
rescue => e
  Q.log "[pad/ws] member write failed: #{e.class}: #{e.message}"
end

def remove_member(cid)
  File.unlink(member_file(cid)) if File.exist?(member_file(cid))
rescue => e
  Q.log "[pad/ws] member remove failed: #{e.class}: #{e.message}"
end

def read_members
  out = []
  Dir.glob(File.join(MEM_DIR, '*.json')).each do |f|
    begin
      info = JSON.parse(File.read(f))
      # 心跳超时的不算在线
      next if info['ts'].to_i < Time.now.to_i - MEMBER_TTL
      out << info
    rescue JSON::ParserError, Errno::ENOENT
      next
    end
  end
  out
end

def broadcast_members(mcast)
  members = read_members
  payload = JSON.generate({ t: 'members', members: members })
  mcast.notify(PAD_CHANNEL, payload)
  members
end

# ── WS 端点 ────────────────────────────────────────────────
Q.ws do |req, rsp|
  # BDR 连接 —— 连 spider 自己的端口
  #
  # host/port 不传 → 127.0.0.1 + $Cgi_Port（spider 注入的监听端口）
  mcast = TcpNotify.new("cgi-pad-#{Process.pid}", channel: PAD_CHANNEL)
  cid   = nil
  name  = 'anon'
  color = '#c4f542'

  # 订阅广播：别的客户端的 op 和成员表
  #
  # want_echo=false —— 跳过自己发的（BDR 会把消息发给发送者自己）。
  # 自己那份走 rsp.ws_write（见下面各分支）。
  mcast.notify(PAD_CHANNEL, false) do |msg|
    data = msg.data
    next if data.nil? || data.empty?
    rsp.ws_write(data)
  end

  Q.log "[pad/ws] + client"

  Q.on_close do
    # ★ 离线通知 —— 删完成员文件**必须广播一次**成员表。
    #   成员表是"谁在线"的唯一来源（前端 onMembers 直接整个替换 members Map），
    #   不广播的话其他人不会知道这个人走了 →
    #   · 远端光标变成幽灵，一直挂在屏幕上
    #   · peers online 计数不减
    #   而且只有等下次有人发消息（hello/presence/op）才会顺带更新，
    #   没人说话的话这个错误状态会一直挂着。
    #
    #   顺序：先删文件 → 再广播（广播出去的就是"他已经不在了"的名单）
    #         → 最后才 stop（notify 是同步写 socket，先发出去再关）
    if cid
      remove_member(cid)
      broadcast_members(mcast)
      Q.log "[pad/ws] - client #{cid}"
    end
    mcast.stop
  end

  req.on_ws_data do |chunk|
    begin
      line = chunk.to_s
      next nil if line.empty?

      msg = begin
        JSON.parse(line)
      rescue JSON::ParserError
        Q.log '[pad/ws] bad json'
        next nil
      end
      next nil unless msg.is_a?(Hash)

      case msg['t']
      when 'hello'
        # 首次 hello → 分配 clientId
        #
        # ★ 这个 id 同时是 **CRDT 身份** 和 **成员表身份** —— 全局只有一个。
        #   客户端拿到它（hello-ack）之后：
        #     · op 的 id 用它        → id: [cid, seq]
        #     · 成员表里排除自己用它  → 跟成员表的 id 天然一致，不会对不齐
        #   之前是客户端自己生成 UUID 做 CRDT 身份、服务端另分配 cid 做成员表身份，
        #   两套 id 永远不相等 → 前端把自己当成了别人的远端光标。
        #
        #   格式要求（compareId 用字典序比较 id[0]）：
        #     · 固定前缀 + 零填充数字 → 字典序 = 数值序
        #     · 全局唯一（多机部署时 pid 可能撞 → 掺随机后缀）
        cid   = new_client_id
        name  = msg['name'].to_s[0, 32]
        color = msg['color'].to_s[0, 16]
        write_member(cid, { 'id' => cid, 'name' => name, 'color' => color,
                            'cursor' => 0, 'ts' => Time.now.to_i })
        Q.log "[pad/ws] hello #{cid} #{name}"

        # ★ 把服务端分配的 id 告诉客户端。
        #   客户端自己也有一个 clientId（crypto.randomUUID），
        #   但**成员表里的 id 用的是服务端的 cid**（c<ts>-<pid>），
        #   两者永远不相等 → 前端 `id === myClientId` 判不出"哪个是我自己"，
        #   会把自己的光标当成别人的远端光标渲染出来。
        #   所以 hello-ack 里带上 cid，客户端用它覆盖 myClientId。
        #   （op 的 id 仍用客户端自己的 UUID —— 那是 CRDT 身份，跟成员表 id 无关。）
        rsp.ws_write(JSON.generate({ t: 'hello-ack', id: cid }))

        # ★ 这里**不**发全量 op。
        #   客户端连上时会同时发 hello + sync（见 sync.js），
        #   如果 hello 也发一份全量，每个新客户端就会收到两份全量 op
        #   （实测 13 条 log → 客户端收 26 条）。
        #   全量 op 只由 'sync' 分支发一次，避免重复。

        # 发成员表 ——
        # 广播用的是 want_echo=false（跳过自己发的），
        # 所以请求者自己那份要直接 ws_write 一次。
        members = broadcast_members(mcast)
        rsp.ws_write(JSON.generate({ t: 'members', members: members }))

      when 'sync'
        ops = read_ops
        # 'total' 是服务器 op log 的权威总数 ——
        # 客户端用它显示"全局 ops"，不用自己数收到的 op
        # （增量广播 + 全量同步会让客户端自己数出来的数对不上）。
        rsp.ws_write(JSON.generate({ t: 'ops', ops: ops, total: ops.size }))

      when 'clear'
        # 清空文档 —— 服务器删掉 op log，通知所有客户端重置本地 Doc。
        # 这是"权威在服务器"的好处：清空是一次广播，不用逐个客户端协商。
        log_lock.flock(File::LOCK_EX)
        begin
          log_lock.truncate(0)
          log_lock.flush
          @op_seen = {}
        ensure
          log_lock.flock(File::LOCK_UN)
        end
        mcast.notify(PAD_CHANNEL, JSON.generate({ t: 'clear' }))
        rsp.ws_write(JSON.generate({ t: 'clear' }))
        Q.log '[pad/ws] document cleared'

      when 'op'
        op = msg['op']
        next nil unless op.is_a?(Hash)
        ok = append_op(op)
        if ok
          # 广播给其他客户端（自己那份本地已经应用了）
          mcast.notify(PAD_CHANNEL, JSON.generate({ t: 'ops', ops: [op] }))
        end

      when 'profile'
        # ★ 改自己的名称 / 颜色。
        #   成员表里的 name/color 是客户端**发过来**的，不是服务器分配的，
        #   所以这里只更新服务器保存的那份 + 广播新的成员表。
        if cid
          name  = msg['name'].to_s[0, 32]
          color = msg['color'].to_s[0, 16]
          # 保留原来的 cursor —— 改名字不该把自己的光标位置抹成 0
          # （否则别人的远端光标会突然跳到开头）
          old   = read_members.find { |m| m['id'] == cid } || {}
          write_member(cid, { 'id' => cid, 'name' => name, 'color' => color,
                              'cursor' => old['cursor'].to_i, 'ts' => Time.now.to_i })
          # 广播 —— 别人的成员表要更新（自己的那份走 rsp.ws_write）
          members = read_members
          payload = JSON.generate({ t: 'members', members: members })
          mcast.notify(PAD_CHANNEL, payload)
          rsp.ws_write(payload)
          Q.log "[pad/ws] profile #{cid} #{name} #{color}"
        end

      when 'presence'
        if cid
          info = { 'id' => cid, 'name' => name, 'color' => color,
                   'cursor' => msg['cursor'].to_i, 'ts' => Time.now.to_i }
          write_member(cid, info)
          # 光标变化要立刻推给其他人；
          # 广播是 want_echo=false（跳过自己发的），所以自己也直接发一份
          members = read_members
          payload = JSON.generate({ t: 'members', members: members })
          mcast.notify(PAD_CHANNEL, payload)
          rsp.ws_write(payload)
        end

      else
        Q.log "[pad/ws] unknown msg #{msg['t']}"
      end
    rescue => e
      Q.log "[pad/ws] err: #{e.class}: #{e.message}"
    end
    nil
  end
end
