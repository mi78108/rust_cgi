#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/editdoc/ws — 协作编辑 WebSocket 透明转发端点
#
#   WS /tool/editdoc/ws
#
#   前端用 @weavo/client (CRDT) 连接本端点, 后端只做跨进程转发:
#     收到浏览器帧 → SocketNotify (UDP multicast) 广播给其他 ws 连接
#     收到 multicast 帧 → Q.write 推给本连接的浏览器
#
#   后端不解析、不存储文档状态 —— CRDT 收敛全部由 @weavo/client 在浏览器端完成。
#
#   二进制帧: weavo 用 socket.binaryType='arraybuffer', 帧是任意字节序列。
#   SocketNotify 的 fmt=bin 通道原样透传 bytes (不再需要 base64 中转),
#   Q.write 是裸 STDOUT.write, 不做编码转换。
#
#   echo 回自己: weavo 的 CASPaxos acceptor 需要收到包含自己的 mem 帧才能完成 join,
#   否则 membership.isJoined() 永远 false. 纯广播会导致 join 永远超时。
#
#   spider 是 fork-per-request, 每个 ws 连接一个 ruby 进程, 各自持有 SocketNotify 实例.
#   广播靠 UDP 组播 (239.255.0.1:5000) 跨进程, 仅限同机 —— demo 足够.

require_relative '../../_base_'
require_relative '../../_ext_notify_'

# 单帧上限: SocketNotify 的 PACKET_LIMIT (60KB, 与 _ext_notify_.rb 保持一致)。
# 注意 UDP 单包硬上限 ~65507 字节, 且大包会被 IP 分片 —— 丢包时 weavo 会走
# heartbeat/state-vector 重试恢复, 但延迟会变高。
FRAME_MAX = 60 * 1024

Q.ws do |req|
  mcast = SocketNotify.new("cgi-editdoc-#{Process.pid}")

  mcast.notify(:editdoc) do |msg|
    next if msg.pid.to_i == Process.pid # 自我回环 (自己 emit 的收不到)
    begin
      Q.write(msg.data, true)
    rescue => e
      Q.log("[editdoc/ws] mcast->ws err: #{e.message}")
    end
  end

  Q.log('[editdoc/ws] + client')

  Q.on_close do
    mcast.stop
    Q.log('[editdoc/ws] - client')
  end

  req.on_ws_data do |chunk|
    begin
      if chunk.bytesize > FRAME_MAX
        Q.log "[editdoc/ws] frame too big: #{chunk.bytesize}"
      else
        # fmt=bin 原样透传字节 + echo 回自己 (weavo join 需要)
        mcast.notify(:editdoc, chunk, fmt: :bin)
        Q.write(chunk, true)
        Q.log "notify #{chunk.bytesize}"
        sleep 0.001
      end
    rescue => e
      Q.log("[editdoc/ws] relay err: #{e.message}")
    end
    nil
  end
end
