#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/delete — 删除分享（取消分享 / 丢弃未完成）
#
#   DELETE /tool/share/delete/<token>[?c=<clientId>]
#   DELETE /tool/share/delete/<token>[?pw=<密码>]
#
# 两种授权方式（任一满足即可）：
#
#   1. 归属校验 c=<clientId>：meta 里 by == c 才放行。
#      「我的分享」本来就是按 by 过滤的（list?c=），所以同一个浏览器
#      生成的 clientId 就是这个分享的所有者凭证。不需要密码。
#
#   2. 密码校验 pw=<密码>：分享者自己设的密码，老行为保留
#      （给「知道密码但换设备」的场景留个后路）。
#
#   3. 未完成的（done=0）允许无凭证直接丢 —— 它还没对外发过链接，
#      留着只是等续传。
#
# 为什么不能「裸 token 就删」：
#   token 只有 16 位 hex，分享出去的链接别人捡到就能删掉别人的分享。
#
# → 200 {ok:true, data:{token, deleted:true}}

require_relative '../../_base_'
require_relative '_lib_'

ensure_share_root!

Q.delete %r{^/(?<token>[a-f0-9]{16})$} do |req, rsp|
  token = req.named(:token)
  s = Share.find(token)
  return Share.missing(rsp) if s.nil?

  cid = req.param('c').to_s.gsub(/[^A-Za-z0-9_-]/, '')[0, 40]
  # 这里是 pw 不是 p —— 跟 download 的 ?p= 故意不一样：
  #   download 的 ?p= 会出现在分享链接里（对方点开就要输密码），要短；
  #   delete 是内部管理接口，前端只传 ?c= 或 ?pw=，用全称更清楚。
  # 两边各自保持原样，别「顺手统一」。
  pw  = req.param('pw').to_s

  unless s.authorized?(cid: cid, pw: pw, require_cred: true) || s.discardable?
    # 区分「凭证错了」和「压根没给凭证」，提示才准确
    given = !cid.empty? || !pw.empty?
    return s.fail(rsp, 403,
                  given ? '没有权限删除这个分享' : '需要密码或上传者身份才能删除')
  end

  s.destroy!
  s.ok(rsp, { token: token, deleted: true })
end

# 用错方法时给提示
Q.get '/' do |_req, rsp|
  json(rsp, 405, ok: false, error: 'DELETE /tool/share/delete/<token>')
end