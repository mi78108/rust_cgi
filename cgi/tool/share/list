#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/list — 列出分享
#
#   GET /tool/share/list?c=<clientId>   只列这个 clientId 上传的（'by' 字段匹配）
#   GET /tool/share/list                列全部分享（按上传时间倒序）
#   GET /tool/share/list?pub=1          只列「公开且已完成」的（公开广场用）
#   GET /tool/share/list/<token>        单个分享详情（续传入口用）
#
# → 200 {ok:true, data:[{token, url, dl, name, size, type, max, left, pub, editable,
#                       has_pw, exp_at, done, chunk, total_parts, got_parts, at}, ...]}
# → 200 {ok:true, data:{...单个...}}      （带 /<token> 时）
#
# editable：带 ?c=<clientId> 且与该条 by 一致时为 true（= 这个分享归你管）。
# 不带 c 时恒为 false —— 没给身份就不该让前端显示管理按钮。
#
# 删除（丢弃未完成的上传）在 tool/share/delete（DELETE /tool/share/delete/<token>）。
#
# 排序：新的在前（at 倒序）。
# 只读元信息，不碰 data 文件。
# 密码只回 has_pw 布尔值，不回明文。
#
# 顺带做懒清理：list 是最常被访问的接口，正好在这里把已标记 dead 的
# 目录物理删掉（比在 s 的下载路径上等下一次访问更早）。

require_relative '../../_base_'
require_relative '_lib_'

ensure_share_root!
require 'fileutils'


def dead_reason(m)
  return 'quota' if m['max'].to_i > 0 && m['left'].to_i <= 0
  exp_at = m['exp_at'].to_i
  return 'expired' if exp_at > 0 && Time.now.to_i >= exp_at
  nil
end

# 扫已收到的分片文件 part/<n> → [0, 2, 5, ...]（升序）

# 构造一条分享记录（list 和单条查询共用）
# editable：调用方带了 c 且跟 by 一致 → 这个分享归他管，前端可以显示
#   「修改 / 取消分享」。判定放在服务端，前端就不用自己猜。
def build_item(mp, m, cid = nil)
  token = File.basename(File.dirname(mp))
  done = m['done'].to_i
  {
    token:   token,
    # 分享链接指向下载详情页，不是文件本体 —— 私密分享（pub=0 或设了密码）
    # 落到详情页才能输密码；直接给 download/<token> 会让对方拿到文件却没机会输。
    url:     "/tool/share/download?t=#{token}",
    dl:      "/tool/share/download/#{token}",
    name:    m['name'],
    size:    m['size'].to_i,
    type:    m['type'].to_s,
    max:     m['max'].to_i,
    left:    m['left'].to_i,
    pub:     m.fetch('pub', 1).to_i,      # 1=公开 / 0=私密
    has_pw:  !m['pw'].to_s.empty?,
    exp_at:  m['exp_at'].to_i,
    at:      m['at'].to_i,
    done:    done,
    editable: (!cid.to_s.empty? && m['by'].to_s == cid),
    chunk:   m['chunk'].to_i,
    total_parts: m['total_parts'].to_i,
    got_parts:  (done == 0 ? got_parts(token) : [])
  }
end

# ---------- GET /<token> : 单个分享详情（续传入口） ----------

Q.get %r{^/(?<token>[a-f0-9]{16})$} do |req, rsp|
  token = req.named(:token)
  mp = File.join(SHARE_ROOT, token, 'meta.json')
  return json(rsp, 404, ok: false, error: 'not found') unless File.file?(mp)

  m = (JSON.parse(File.read(mp)) rescue nil)
  return json(rsp, 404, ok: false, error: 'not found') unless m.is_a?(Hash)

  cid = req.param('c').to_s.gsub(/[^A-Za-z0-9_-]/, '')[0, 40]
  json(rsp, 200, ok: true, data: build_item(mp, m, cid))
end

# ---------- GET / : 列表 ----------

Q.get '/' do |req, rsp|
  cid = req.param('c').to_s.gsub(/[^A-Za-z0-9_-]/, '')[0, 40]
  # pub=1：公开广场。只列「已完成 + 公开」的 —— 未完成的还没内容，
  # 私密的不该出现在公开列表里。
  pub_only = req.param('pub').to_s == '1'

  items = []
  Dir.glob(File.join(SHARE_ROOT, '*', 'meta.json')).each do |mp|
    m = (JSON.parse(File.read(mp)) rescue nil)
    next unless m.is_a?(Hash)
    token = File.basename(File.dirname(mp))

    reason = dead_reason(m)

    # 懒清理：已标记 dead 的（或已失效且早于本请求的）→ 物理删除，不出现在列表
    # 未完成的（done=0）不清理，等着续传
    if m['dead'] || (reason && m['done'] != 0)
      FileUtils.rm_rf(File.dirname(mp))
      next
    end

    if pub_only
      next unless m['done'].to_i != 0
      next unless m.fetch('pub', 1).to_i != 0
    else
      # 传了 c 就只返回该 client 的（清理照做，不受 c 影响）
      next if !cid.empty? && m['by'].to_s != cid
    end

    items << build_item(mp, m, cid)
  end

  items.sort_by! { |i| -i[:at] }
  json(rsp, 200, ok: true, data: items)
end
