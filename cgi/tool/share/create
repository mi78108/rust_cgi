#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/create — 分片上传第一步：建 token
#
#   POST /tool/share/create?c=<clientId>&name=&type=&size=<字节>&max=&exp=<h>&pw=&chunk=<字节>&pub=<0|1>
#
#   chunk 单位是字节（前端把 KB 乘 1024 后传上来）。
#   chunk=0 表示不分片 —— 服务端建一个空 data 文件并标记 done=1，
#   等价于一次普通上传（前端仍走 multipart POST /upload，不该用到这里）。
#
#   pub=1 公开（默认，缺省即公开）；pub=0 私密 —— 私密强制要求密码，
#   带 pub=0 且 pw 为空直接 400（见下面校验）。
#
#   → 200 {ok:true, data:{token, total_parts, chunk, got_parts:[]}}
#
# 为什么要 create：token 要在传第一个分片之前就确定，浏览器才有地方续传
# （刷新页面后拿 token + 重新选文件，从已收的分片继续）。
#
# 完整分片流程：
#   1) POST /tool/share/create?...        → token
#   2) PUT  /tool/share/upload?token=&n=  → 每一片
#   3) POST /tool/share/finish?token=     → 合并 part/* → data，返回分享链接
#
# 存储布局（跟 /upload 一致，只是多一个 part/ 目录）:
#   $SPIDER_DATA/<token>/meta.json   {done:0, chunk, total_parts, pub, ...}
#   $SPIDER_DATA/<token>/part/<n>     每个分片一个文件（幂等：重传直接覆盖）
#   $SPIDER_DATA/<token>/data         finish 时按序合并而成

require_relative '../../_base_'
require_relative '_lib_'

ensure_share_root!

Q.post '/' do |req, rsp|
  size = req.param('size').to_i
  return json(rsp, 400, ok: false, error: "bad size: #{req.param('size')}") if size <= 0

  chunk = req.param('chunk').to_i
  return json(rsp, 400, ok: false, error: "bad chunk: #{req.param('chunk')}") if chunk.negative?

  max = req.param('max').to_i
  max = 0 if max.negative?
  max = 100_000 if max > 100_000

  exp_h = req.param('exp').to_i
  exp_h = 0 if exp_h.negative?
  exp_h = 87_600 if exp_h > 87_600

  pub = req.param('pub', '1').to_s != '0' ? 1 : 0
  pw  = req.param('pw').to_s
  # 私密必须带密码，否则这个分享等于公开却标着「私密」，自相矛盾
  return json(rsp, 400, ok: false, error: '私密分享必须设置密码（pub=0 需要 pw）') if pub.zero? && pw.empty?

  s = Share.create(name:  req.param('name'),
                   type:  req.param('type'),
                   size:  size,
                   chunk: chunk,
                   max:   max,
                   exp_h: exp_h,
                   pub:   pub,
                   pw:    pw,
                   owner: req.param('c'))

  json(rsp, 200, ok: true, data: s.to_create_info)
end

Q.get '/' do |_req, rsp|
  json(rsp, 405, ok: false,
       error: 'POST /tool/share/create?c=&name=&type=&size=&max=&exp=&pw=&chunk=')
end
