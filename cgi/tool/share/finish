#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/finish — 分片上传收尾（合并 part/* → data）
#
#   POST /tool/share/finish?token=<t>
#   → 200 {ok:true, data:{token, url, name, size, type, max, has_pw, exp_at, merged}}
#
# 做的事：
#   1. 校验 part/ 齐全（缺片直接 409 + 列出缺哪些，前端好提示续传）
#   2. 按序合并成 data（写到临时文件再 rename —— 原子，避免中途被读到半个文件）
#   3. meta.done = 1
#   4. 删掉 part/ 目录（省空间）
#
# 为什么先写临时文件再 rename：
#   下载端 GET /tool/share/download/<token> 直接读 data 文件。如果边合并边被下载，
#   对方拿到的是残缺内容。rename 在同一文件系统内是原子的，
#   下载端要么看到旧状态（没有 data），要么看到完整的。

require_relative '../../_base_'
require_relative '_lib_'

ensure_share_root!

Q.post '/' do |req, rsp|
  token = req.param('token').to_s
  return json(rsp, 400, ok: false, error: 'missing token') unless Share::TOKEN_RE.match?(token)

  s = Share.find(token)
  return Share.missing(rsp) if s.nil?

  # 幂等：已完成就直接返回成功（客户端重试 finish 不会报错）
  return json(rsp, 200, ok: true, data: s.to_finish_info(0, already: true)) if s.done?

  missing = s.missing_parts
  unless missing.empty?
    return json(rsp, 409, ok: false,
                error: "missing #{missing.length} part(s): #{missing.first(20).join(',')}",
                data: { got: s.got_parts, total_parts: s.total_parts, missing: missing })
  end

  begin
    merged = s.merge_parts!
  rescue RangeError => e
    return json(rsp, 500, ok: false, error: e.message)
  end

  json(rsp, 200, ok: true, data: s.to_finish_info(merged))
end

Q.get '/' do |_req, rsp|
  json(rsp, 405, ok: false, error: 'POST /tool/share/finish?token=')
end
