#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/finish — 分片上传收尾（合并 part/* → data）
#
#   POST /tool/share/finish?token=<t>
#   → 200 {ok:true, data:{token, url, name, size, type, max, has_pw, exp_at, merged}}
#
# 做的事：
#   1. 校验 part/ 齐全（缺片直接 409 + 列出缺哪些，前端好提示续传）
#   2. 按序合并成 data（写到临时文件再 rename —— 原子，避免中途被读到半个文件）
#   3. meta.done = 1
#   4. 删掉 part/ 目录（省空间）
#
# 为什么先写临时文件再 rename：
#   下载端GET /f/<token> 直接读 data 文件。如果边合并边被下载，
#   对方拿到的是残缺内容。rename 在同一文件系统内是原子的，
#   下载端要么看到旧状态（没有 data），要么看到完整的。

require_relative '../../_base_'
require 'fileutils'

SHARE_ROOT = ENV.fetch('SPIDER_DATA', nil).to_s.empty? ? '/tmp/share' : ENV['SPIDER_DATA']

FileUtils.mkdir_p(SHARE_ROOT) unless File.directory?(SHARE_ROOT)

def dir_of(token)   = File.join(SHARE_ROOT, token)
def meta_path(token) = File.join(dir_of(token), 'meta.json')

def json(rsp, code, payload)
  rsp.code(code).type_json.body(payload.to_json).finish
end

def got_parts(token)
  pdir = File.join(dir_of(token), 'part')
  return [] unless File.directory?(pdir)
  Dir.children(pdir).select { |f| f =~ /\A\d+\z/ }.map(&:to_i).sort
end

Q.post '/' do |req, rsp|
  token = req.param('token').to_s
  return json(rsp, 400, ok: false, error: 'missing token') unless token =~ /\A[a-f0-9]{16}\z/

  mp = meta_path(token)
  return json(rsp, 404, ok: false, error: 'not found') unless File.file?(mp)

  m = (JSON.parse(File.read(mp)) rescue nil)
  return json(rsp, 404, ok: false, error: 'not found') unless m.is_a?(Hash)

  # 幂等：已完成就直接返回成功（客户端重试 finish 不会报错）
  if m['done'].to_i != 0
    return json(rsp, 200, ok: true, data: {
      token: token, url: "/tool/share/download/f/#{token}",
      name: m['name'], size: m['size'], type: m['type'],
      max: m['max'], has_pw: !m['pw'].to_s.empty?, exp_at: m['exp_at'].to_i,
      merged: 0, already: true
    })
  end

  total = m['total_parts'].to_i
  got = got_parts(token)

  # 缺片 → 409，告诉前端缺哪些
  missing = (0...total).to_a - got
  unless missing.empty?
    return json(rsp, 409, ok: false,
                error: "missing #{missing.length} part(s): #{missing.first(20).join(',')}",
                data: { got: got, total_parts: total, missing: missing })
  end

  # 按序合并 → 临时文件 → rename（原子）
  tmp = File.join(dir_of(token), 'data.tmp')
  merged = 0
  File.open(tmp, 'wb') do |out|
    (0...total).each do |i|
      pf = File.join(dir_of(token), 'part', i.to_s)
      data = File.binread(pf)
      out.write(data)
      merged += data.bytesize
    end
  end

  # 大小校验：合并结果必须等于声明的 size
  if merged != m['size'].to_i
    File.delete(tmp)
    return json(rsp, 500, ok: false,
                error: "size mismatch: merged #{merged} != declared #{m['size']}")
  end

  File.rename(tmp, File.join(dir_of(token), 'data'))
  FileUtils.rm_rf(File.join(dir_of(token), 'part'))

  m['done'] = 1
  File.write(mp, m.to_json)

  json(rsp, 200, ok: true, data: {
    token: token,
    url:   "/tool/share/download/f/#{token}",
    name:  m['name'],
    size:  m['size'],
    type:  m['type'],
    max:   m['max'],
    has_pw: !m['pw'].to_s.empty?,
    exp_at: m['exp_at'].to_i,
    merged: merged
  })
end

Q.get '/' do |_req, rsp|
  json(rsp, 405, ok: false, error: 'POST /tool/share/finish?token=')
end