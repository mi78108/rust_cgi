#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/edit — 修改分享配置（下载次数 / 有效期 / 密码 / 是否公开）
#
#   POST /tool/share/edit?token=<t>&c=<clientId>
#        &max=<n>   下载次数上限（0 = 无限）
#        &exp=<h>   有效期小时数，0 = 永久。传 -1 = 不改
#        &pw=<..>   新密码。传 ""（空值）= 改成免密；不传该参数 = 不改
#        &pub=<0|1> 是否公开。传 -1 = 不改
#
#   → 200 {ok:true, data:{token, max, left, exp, exp_at, pub, has_pw}}
#
# 授权：c 必须等于 meta 里的 by（上传者的 clientId）。没有密码兜底 ——
#   「修改配置」比「删除」更需要限定所有者：删除是恢复到没人能访问的
#   状态，修改却可能把私密分享改成公开。只认 clientId 归属。
#
# 只改配置，不动 data 文件。已失效（次数用完/过期）的分享也能改 ——
#   把 max 调大或续期 exp，link 就"复活"了，这是合理的补救路径。
#
# 为什么 exp/pw/pub 用哨兵值而不是「缺省不改」：
#   exp 的合法值包含 0（永久），pw 的合法值包含空串（免密），
#   pub 的合法值包含 0（私密）—— 三者都有「合法且需要显式表达」的值，
#   所以不能用「参数缺失」来表示不改，统一用 -1 / 不传参数 / 空串区分。

require_relative '../../_base_'
require 'fileutils'

SHARE_ROOT = ENV.fetch('SPIDER_DATA', nil).to_s.empty? ? '/tmp/share' : ENV['SPIDER_DATA']

FileUtils.mkdir_p(SHARE_ROOT) unless File.directory?(SHARE_ROOT)

def dir_of(token)   = File.join(SHARE_ROOT, token)
def meta_path(token) = File.join(dir_of(token), 'meta.json')

def json(rsp, code, payload)
  rsp.code(code).type_json.body(payload.to_json).finish
end

Q.post %r{^/?(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  token = req.named(:token)
  mp = meta_path(token)
  return json(rsp, 404, ok: false, error: 'not found') unless File.file?(mp)

  m = (JSON.parse(File.read(mp)) rescue nil)
  return json(rsp, 404, ok: false, error: 'not found') unless m.is_a?(Hash)

  # ── 归属校验 ──
  cid = req.param('c').to_s.gsub(/[^A-Za-z0-9_-]/, '')[0, 40]
  return json(rsp, 403, ok: false, error: '没有权限修改这个分享') if cid.empty?
  return json(rsp, 403, ok: false, error: '只有上传者可以修改这个分享') unless m['by'].to_s == cid

  # ── 下载次数上限 ──
  if req.param('max')
    max = req.param('max').to_i
    max = 0 if max.negative?
    max = 100_000 if max > 100_000
    old_max = m['max'].to_i
    m['max'] = max
    # left 按「还剩多少」重算：new_left = 新上限 - (已用掉的次数)
    used = old_max > 0 ? (old_max - m['left'].to_i) : 0
    used = 0 if used.negative?
    m['left'] = max > 0 ? [max - used, 0].max : max
  end

  # ── 有效期（-1 = 不改）──
  if req.param('exp')
    exp_h = req.param('exp').to_i
    unless exp_h.negative?
      exp_h = 87_600 if exp_h > 87_600
      m['exp'] = exp_h
      m['exp_at'] = exp_h > 0 ? Time.now.to_i + exp_h * 3600 : 0
    end
  end

  # ── 密码（不传 = 不改；传空串 = 改成免密）──
  if req.param('pw')
    pw = req.param('pw').to_s[0, 64]
    # 取消密码后如果它本来是「私密」，那这个分享就没有任何保护了 ——
    # 自动降级成公开，否则下载端会因为「私密却没密码」而永久拒绝（死锁）。
    if pw.empty? && m.fetch('pub', 1).to_i.zero?
      m['pub'] = 1
    end
    m['pw'] = pw
  end

  # ── 是否公开（-1 = 不改）──
  if req.param('pub')
    pub = req.param('pub').to_i
    unless pub.negative?
      pub = 1 if pub > 1
      # 改成私密必须有密码，否则这个分享等于公开却标着「私密」，
      # 而且下载端会一直 401 谁都下不了 —— 直接拒绝这个组合。
      if pub.zero? && m['pw'].to_s.empty?
        return json(rsp, 400, ok: false, error: '私密分享必须设置密码')
      end
      m['pub'] = pub
    end
  end

  File.write(mp, m.to_json)

  json(rsp, 200, ok: true, data: {
    token:  token,
    max:    m['max'].to_i,
    left:   m['left'].to_i,
    exp:    m['exp'].to_i,
    exp_at: m['exp_at'].to_i,
    pub:    m.fetch('pub', 1).to_i,
    has_pw: !m['pw'].to_s.empty?
  })
end

Q.get %r{^/?$} do |_req, rsp|
  json(rsp, 405, ok: false, error: 'POST /tool/share/edit?token=&c=&max=&exp=&pw=&pub=')
end