#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/edit — 修改分享配置（下载次数 / 有效期 / 密码 / 是否公开）
#
#   POST /tool/share/edit?token=<t>&c=<clientId>
#        &max=<n>   下载次数上限（0 = 无限）
#        &exp=<h>   有效期小时数，0 = 永久。传 -1 = 不改
#        &pw=<..>   新密码。传 ""（空值）= 改成免密；不传该参数 = 不改
#        &pub=<0|1> 是否公开。传 -1 = 不改
#
#   → 200 {ok:true, data:{token, max, left, exp, exp_at, pub, has_pw}}
#
# 授权：c 必须等于 meta 里的 by（上传者的 clientId）。没有密码兜底 ——
#   「修改配置」比「删除」更需要限定所有者：删除是恢复到没人能访问的
#   状态，修改却可能把私密分享改成公开。只认 clientId 归属。
#
# 只改配置，不动 data 文件。已失效（次数用完/过期）的分享也能改 ——
#   把 max 调大或续期 exp，link 就"复活"了，这是合理的补救路径。
#
# 为什么 exp/pw/pub 用哨兵值而不是「缺省不改」：
#   exp 的合法值包含 0（永久），pw 的合法值包含空串（免密），
#   pub 的合法值包含 0（私密）—— 三者都有「合法且需要显式表达」的值，
#   所以不能用「参数缺失」来表示不改，统一用 -1 / 不传参数 / 空串区分。

require_relative '../../_base_'
require_relative '_lib_'

ensure_share_root!

Q.post %r{^/?(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  token = req.named(:token)
  s = Share.find(token)
  return Share.missing(rsp) if s.nil?

  # ── 归属校验：只认 clientId，不接受密码兜底 ──
  # 「修改配置」比「删除」更需要限定所有者：删除只是回到没人能访问的状态，
  # 修改却可能把一个私密分享改成公开。
  cid = req.param('c').to_s.gsub(/[^A-Za-z0-9_-]/, '')[0, 40]
  return s.fail(rsp, 403, '没有权限修改这个分享') if cid.empty?
  return s.fail(rsp, 403, '只有上传者可以修改这个分享') unless s.owned_by?(cid)

  s.apply_max!(req.param('max').to_i) if req.param('max')
  s.apply_exp!(req.param('exp').to_i) if req.param('exp')
  s.apply_pw!(req.param('pw'))         if req.param('pw')

  # 改成私密必须有密码，否则这个分享等于公开却标着「私密」，
  # 而且下载端会一直 401 谁都下不了 —— 直接拒绝这个组合。
  if req.param('pub')
    pub = req.param('pub').to_i
    if !pub.negative? && pub.zero? && !s.can_be_private?
      return s.fail(rsp, 400, '私密分享必须设置密码')
    end
    s.apply_pub!(pub)
  end

  s.save!
  s.ok(rsp, s.to_config)
end

Q.get %r{^/?$} do |_req, rsp|
  json(rsp, 405, ok: false, error: 'POST /tool/share/edit?token=&c=&max=&exp=&pw=&pub=')
end
