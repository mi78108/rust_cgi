#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/preview — 公开分享的在线预览
#
#   GET /tool/share/preview/<token>   → 直接吐文件，inline 渲染，不扣次数
#
# 为什么单独一个端点（不能直接复用 download/f）：
#   1. download/f 每调一次扣一次下载次数。预览是「看一眼」，不该烧额度 ——
#      在公开广场点几下预览就把次数用光，明显不合理。
#   2. download/f 发的是 attachment（强制下载），浏览器会弹保存框而不是内嵌渲染。
#   3. download/f 要验密码；而广场上的公开分享不该因为「看一眼」还要输密码。
#
# 安全边界（最关键的一条）：
#   **只服务 pub=1 的分享**，私密的直接 403。
#   所以它不是「绕过密码」的后门 —— 私密分享该要密码还是要密码（走 download/f），
#   预览端点对它完全关门。能被预览的，本来就是「拿到链接就能下」的那些。
#
# 已失效的不预览：次数用完 / 已过期 / dead 标记 → 410。
#   预览不该把一个已经失效的链接「复活」—— 失效就是失效。
#
# 只读、不改任何状态：不写 meta.json、不动 left、不动 exp_at。
#
# Content-Type 用 meta 里存的原始 MIME，text/* 补上 charset=utf-8
#   （中文 txt 最容易因为浏览器猜错编码显示成乱码）。
# Content-Disposition 用 inline，让浏览器把它当页面内容渲染而不是下载。

require_relative '../../_base_'
require_relative '_lib_'

# 解析 Range 请求头 → [first, last]（闭区间，字节偏移），不支持就返回 nil
#   Range: bytes=0-            → 0 .. size-1
#   Range: bytes=100-199      → 100 .. 199
#   Range: bytes=-500         → 最后 500 字节（后缀式）
#   Range: bytes=500-         → 500 .. size-1
#   多个 range（bytes=0-1,5-6）不支持 → nil（按整块发）
def parse_range(hdr, size)
  return nil if hdr.to_s.strip.empty?
  m = hdr.strip.match(/\Abytes\s*=\s*(\d*)\s*-\s*(\d*)\z/i)
  return nil unless m
  first, last = m[1], m[2]

  # 后缀式：bytes=-N → 取末尾 N 字节
  if first.empty?
    return nil if last.empty?
    n = last.to_i
    return nil if n <= 0
    n = size if n > size
    return [size - n, size - 1]
  end

  f = first.to_i
  return nil if f >= size          # 越界 → 当作不支持，让上层发整块
  l = last.empty? ? size - 1 : last.to_i
  l = size - 1 if l >= size        # 开放结尾：夹到文件末尾
  return nil if l < f
  [f, l]
end

# 文件的 [offset, offset+len) 片段。
# 为什么不用 Q::Body::StreamBody：它 #size 恒为 nil，Rsp#finish 会直接
# Content-Length: 0 把响应发完，压根不会调 each_chunk（body 不输出）。
# 206 必须带真实的 Content-Length，所以要一个 size 已知的 body。
# each_chunk 按 BUFFER_SIZE 读 → 大视频也是边读边发，不整个读进内存。
class Q
  class RangeBody < Q::Body::Base
    def initialize(path, offset, len)
      @path = path
      @offset = offset
      @len = len
    end

    def size = @len

    def each_chunk(chunk_size = Q::BUFFER_SIZE)
      File.open(@path, 'rb') do |f|
        f.seek(@offset)
        left = @len
        while left > 0 && (buf = f.read([chunk_size, left].min))
          yield buf
          left -= buf.bytesize
        end
      end
    end
  end
end

Q.get %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  s = Share.find(req.named(:token))
  return Share.missing(rsp) if s.nil?

  # ★ 只放行公开分享 —— 预览端点不校验密码，私密分享一律不给
  return s.fail(rsp, 403, '私密分享不支持预览') unless s.public?

  # 预览不做懒清理（:none）—— 它是只读的，每次都打标记/删文件太积极。
  # 失效了就报 410，清理交给下载端和 list 去做。
  unless s.alive?
    return s.fail(rsp, 410, s.dead_message)
  end
  return s.fail(rsp, 404, 'file gone') unless s.data_exists?

  size = File.size(s.data_path)
  rng = parse_range(req.header('range', ''), size)

  s.preview_headers(rsp)

  unless rng
    rsp.type(s.mime_inline).body(s.data_path).finish
  else
    first, last = rng
    rsp.code(206)
       .header_field('Content-Range', "bytes #{first}-#{last}/#{size}")
       .type(s.mime_inline)
       .body(Q::RangeBody.new(s.data_path, first, last - first + 1))
       .finish
  end
end

# 误用其它方法时给个提示
Q.get '/' do |_req, rsp|
  json(rsp, 405, ok: false, error: 'GET /tool/share/preview/<token>')
end
