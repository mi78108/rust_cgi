#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/download — 文件分享：元信息 + 下载
#
#   GET  /tool/share/download?t=<token>       下载详情页（dist/download.html）
#   GET  /tool/share/download/info/<token>   元信息（下载页用）
#   GET  /tool/share/download/<token>?p=<password>  下载（计一次次数）
#   GET  /tool/share/download                 状态 JSON
#
# 上传在 tool/share/upload（POST multipart），不在这里。
# 所有下载相关的接口都在本文件：info（元信息）+ f（实际下载）。
#
# 为什么密码走 URL query 而不是 cookie/session：
#   分享链接常常直接贴给别人（IM / 邮件），带密码的 URL 本身即凭证，
#   对方点开就能下。密码错时不消耗下载次数。
#
# 是否公开（pub 字段，meta 里持久化）：
#   pub=1 公开（默认，旧数据无此字段时按公开处理）—— 下载逻辑跟以前一样，
#         设了密码才校验，没密码就能下。
#   pub=0 私密 —— 强制要求正确密码，缺/错一律 401。创建时就要求 pw 非空
#         （create / upload 里 400 挡住），这里再兜一层底：万一历史数据里
#         出现 pub=0 且 pw 空，也拒绝放行，保证「私密」名不副实时不会泄露。
#   私密 = 「必须有密码」这一条硬约束，密码仍是唯一凭证来源；pub 只是把
#   「这个分享对外公开」这个意图显式落库，并由下载端强制。
#
# 失效策略（次数耗尽 或 到期）—— 懒清理，不依赖定时器：
#   第 1 次碰到失效 → 返回 410 Gone，meta.json 里打 dead 标记（文件仍在）
#   第 2 次再碰到 → FileUtils.rm_rf 整个 token 目录（物理删除）
#   这样"标记失效"和"清理"分开：误判一次不会立刻丢数据，
#   真正清理发生在下一次访问，且不需要后台 cron。
#
# 存储布局（每个分享一个文件夹）:
#   $SPIDER_DATA/<token>/meta.json   元信息 {name,type,size,max,left,pub,pw,by,exp,exp_at,at,dead}
#   $SPIDER_DATA/<token>/data        原始字节
#   SPIDER_DATA 未设置时默认 /tmp/share（部署时用环境变量改，不用改代码）
#   token = SecureRandom.hex(8) → 16 位 hex，短链好记又难猜
#
# 下载次数：成功开始传输时扣 1（扣减 + 发文件在同一进程内完成，
#   单机 CGI 每请求独立进程，正常不会并发写同一个 token；
#   真要并发可以给 meta.json 加 flock）。

require_relative '../../_base_'
require_relative '_lib_'

ensure_share_root!

DOWNLOAD_PAGE = 'dist/download.html'

# ---------- GET: 元信息（下载页用） ----------

Q.get %r{^/info/(?<token>[a-f0-9]{16})$} do |req, rsp|
  s = Share.find(req.named(:token))
  return Share.missing(rsp) if s.nil?
  # 下载端用 :mark —— 第一次发现失效只打标记（本次还能报「次数已用完」而不是
  # 404），下次访问才物理删。误判一次不会立刻丢数据。
  return Share.missing(rsp) if s.reap!(purge: :mark)

  unless s.alive?
    return s.fail(rsp, 410, s.dead_message, data: { name: s.name, size: s.size })
  end
  return s.fail(rsp, 404, 'file gone') unless s.data_exists?

  s.ok(rsp, s.to_info)
end

# ---------- GET: 下载 ----------
#
#   GET /tool/share/download/<token>?p=<password>
#
# 原来这层是 /f/<token>，中间的 f 是为了跟 /info/<token> 区分。现在
# 「info」是字母、「<token>」是 16 位 hex，两者正则上不可能撞，直接省掉这层。

Q.get %r{^/(?<token>[a-f0-9]{16})$} do |req, rsp|
  s = Share.find(req.named(:token))
  return Share.missing(rsp) if s.nil?
  return Share.missing(rsp) if s.reap!(purge: :mark)

  unless s.alive?
    return s.fail(rsp, 410, s.dead_message, data: { name: s.name, size: s.size })
  end

  # 密码校验（密码错的不消耗下载次数）
  # 私密分享（pub=0）强制要求正确密码：哪怕历史数据里 pw 意外为空，
  # 也不能放行（否则「私密」形同虚设）。公开（pub=1）行为不变：设了密码才校验。
  unless s.authorized?(pw: req.param('p'))
    return s.fail(rsp, 401, '密码错误',
                  data: { name: s.name, size: s.size, has_pw: true,
                          pub: s.public? ? 1 : 0 })
  end

  return s.fail(rsp, 404, 'file gone') unless s.data_exists?
  s.serve_attachment(rsp)
end

# ---------- GET / : 详情页（?t=<token>）或状态 ----------
#
# 这个目录名 tool/share/download 跟 URL 前缀同名，spider 的路径解析会把
# /tool/share/download/* 全派发到这里（index 拦不到）。所以详情页的 HTML
# 渲染逻辑放在本脚本，不在 index。

Q.get '/' do |req, rsp|
  t = req.param('t').to_s
  unless t.empty?
    unless File.file?(DOWNLOAD_PAGE)
      return rsp.fail_404.type_text.body("#{DOWNLOAD_PAGE} not found").finish
    end
    return rsp.type_html.body(DOWNLOAD_PAGE).finish
  end

  n = Dir.glob(File.join(SHARE_ROOT, '*')).count { |d| File.directory?(d) }
  rsp.type_json.body({ ok: true, shares: n, root: SHARE_ROOT }.to_json).finish
end
