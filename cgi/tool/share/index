#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/index — 文件分享页面 + 分享链接重定向
#
#   GET /tool/share                        → dist/page.html（提取 / 上传 / 我的分享 / 公开分享）
#   GET /tool/share/view?t=<tok>           → 预览页（dist/view.html）
#   GET /tool/share/download?t=<tok>       → 下载详情页（路由在 download 脚本里）
#   GET /tool/share?t=<token>              → 302 /tool/share/download?t=<token>
#   GET /tool/share/<token>                → 302 /tool/share/download/info/<token>
#
# 详情页 / 预览页不带 .html 后缀 —— spider 的 URL→脚本解析是从路径尾部
# 往前剥文件名，而 cgi/tool/share/download 这个目录名会让 /tool/share/download
# 直接派发给 download 脚本（index 拦不到）。所以详情页的「渲染 HTML」那段
# 逻辑写在 download 脚本的 Q.get '/' 里，带 ?t= 时出页面，不带时出状态 JSON。
#
# 公开分享不再有独立广场页 —— 直接内嵌在 page.html 下方，
# 数据源跟「我的分享」同一个脚本：GET /tool/share/list?pub=1
# （服务端按 pub=1 且 done=1 过滤，私密元信息不会漏出去）。
#
# 预览在独立脚本 tool/share/preview（GET /tool/share/preview/<token>）。
#
# 页面本身是纯 HTML/CSS/JS（无框架，单文件内联），存在 dist/page.html 里，
# 本脚本只负责端出来。
#
# 为什么 ?t=<token> 要重定向而不是直接渲染页面：
#   分享链接是「给人点的」（对方要看文件名、输密码、点下载），
#   而 /tool/share/download?t= 是给程序用的（直接吐文件 / 返回 401/410 JSON）。
#   两者语义不同：页面走 query，接口走 download 脚本。
#   早期版本让 page.html 自己判断 ?t= 切下载视图，现在统一交给 download，
#   页面专心做上传。
#
# 为什么 /tool/share/<token> 也重定向到 info：
#   短链形式更好记（/s/a1b2c3d4），info 返回元信息 JSON 让调用方自己决定怎么展示。
#   值必须是 32 位 hex（跟 share 的 token 格式一致），避免误吞其他路径段。
#
# API 端点（每个独立脚本）：
#   POST   /tool/share/create   分片第一步：建 token
#   POST   /tool/share/upload   不分片 multipart 上传
#   PUT    /tool/share/upload   分片上传（?token=&n=，Content-Range）
#   POST   /tool/share/finish   分片合并收尾
#   GET    /tool/share/list     列表 / 单条详情（续传入口）
#   DELETE /tool/share/delete   丢弃未完成 / 删除
#   GET    /tool/share/download 元信息 / 下载
#   GET    /tool/share/preview  公开分享的内联预览（不扣次数，私密不给）

require_relative '../../_base_'
require_relative '_lib_'

PAGE        = 'dist/page.html'
VIEW_PAGE = 'dist/view.html'
DOWNLOAD_PAGE = 'dist/download.html'

# 预览页 HTML（dist/view.html）。GET /<token>/view 和 GET /view?t= 共用。
def share_view_page(rsp)
  unless File.file?(VIEW_PAGE)
    return rsp.fail_404.type_text.body("#{VIEW_PAGE} not found").finish
  end
  rsp.type_html.body(VIEW_PAGE).finish
end

# 下载详情页 HTML（dist/download.html）。GET /<token>/page 用。
def share_download_page(rsp)
  unless File.file?(DOWNLOAD_PAGE)
    return rsp.fail_404.type_text.body("#{DOWNLOAD_PAGE} not found").finish
  end
  rsp.type_html.body(DOWNLOAD_PAGE).finish
end

# ══════════════════════════════════════════════════════════════
#  API 路由表
#
#  所有端点集中在这里注册 —— 一个入口，一眼看全部。
#  处理逻辑在 api_*.rb（纯模块，不注册路由）。
#
#  顺序很要紧：下面的短链兜底路由 %r{^/(?<token>[a-f0-9]{16})/?$}
#  会匹配任何 16 位 hex 的单段路径，所以更具体的路由必须排在它前面。
# ══════════════════════════════════════════════════════════════

# POST / —— 建分片会话 还是 一次性上传
#   无 query → 建分片会话（size/chunk 等参数之后放在后续请求里）
#   有 query → 一次性上传（配置参数 c/max/exp/pub/pw 在 query，文件在 multipart body）
#
# nil 也判一下：Q::REQ_PARAMS 默认是空字符串，但显式传 nil 时同样表示「无」。
Q.post '/' do |req, rsp|
  if req.query.nil? || req.query.empty?
    Share::Api.create_session(req, rsp)
  else
    Share::Api.create_share(req, rsp)
  end
end


# POST /<token> —— 一次性上传到指定 token
#   token 已完成（done=1）→ 409，不允许覆盖
#   token 未完成（done=0）→ 允许覆盖（半成品重传）
#   token 不存在         → 直接创建
Q.post %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.create_share(req, rsp, req.named(:token))
end

# complete 排在 <token> 前面 —— 否则 PUT 不受影响，但 POST 会先命中短路径
Q.post %r{^/(?<token>[a-f0-9]{16})/complete$} do |req, rsp|
  Share::Api.complete(req, rsp, req.named(:token))
end

Q.put %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.put_part(req, rsp, req.named(:token))
end

# ── 页面 ──────────────────────────────────────────────────────
#   GET /                     上传页（提取 / 上传 / 我的分享 / 公开分享）
#   GET /view?t=<tok>         预览页
#   GET /download?t=<tok>     下载详情页（路由在 download 脚本里 ——
#                             cgi/tool/share/download 这个目录名会让
#                             spider 先派发到它，index 拦不到）

# ── /tool/share?t=<token> → 下载端点 ────────────────────────
Q.get '/' do |req, rsp|
  t = req.param('t').to_s
  # ?t=<token> → 详情页（保留旧链接可用，新链接是 /<token>/page）
  return share_download_page(rsp) if Share::TOKEN_RE.match?(t)

  unless File.file?(PAGE)
    return rsp.fail_404.type_text.body("#{PAGE} not found").finish
  end
  rsp.type_html.body(PAGE).finish
end

# GET /<token>/info —— 分享元信息
# 下载页和预览页加载时用。放在短链兜底之前 —— 短链会匹配任意 16 位 hex 单段。
Q.get %r{^/(?<token>[a-f0-9]{16})/info/?$} do |req, rsp|
  Share::Api.show_info(req, rsp, req.named(:token))
end

# GET /<token>/view —— 这个分享的预览页
# 服务端先校验 token 存在，跟 /info 行为一致 —— 不存在的分享直接 404，
# 别让用户先看到一个空页面再由 JS 报「加载失败」。
Q.get %r{^/(?<token>[a-f0-9]{16})/view/?$} do |req, rsp|
  return fail(rsp, 404) if Share.find(req.named(:token)).nil?
  share_view_page(rsp)
end

# PATCH /<token> —— 改配置（下载次数 / 有效期 / 密码 / 是否公开）
# 原先是 POST /tool/share/edit/<token>，edit 脚本已删除。
Q.patch %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.update(req, rsp, req.named(:token))
end

# DELETE /<token> —— 取消分享 / 丢弃未完成
# 原先是 DELETE /tool/share/delete/<token>，delete 脚本已删除。
Q.delete %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.destroy(req, rsp, req.named(:token))
end


# GET /list —— 分享列表
#   ?c=<clientId>  我的分享
#   ?pub=1         公开广场
#
# /list 是字母，单段路径不会被短链的 16 位 hex 正则匹配到，排哪都行。
Q.get %r{^/list$} do |req, rsp|
  Share::Api.list(req, rsp)
end

# GET /<token>/list —— 单条详情（续传入口）
# 挂在资源下面，跟 /<token>/info、/<token>/view 一致。
Q.get %r{^/(?<token>[a-f0-9]{16})/list/?$} do |req, rsp|
  Share::Api.show(req, rsp, req.named(:token))
end

# GET /<token>/chunk —— 内联预览（inline，不扣下载次数）
# 与 GET /<token>（attachment，扣次数）的区别见 Share::Api.chunk 的注释。
Q.get %r{^/(?<token>[a-f0-9]{16})/chunk/?$} do |req, rsp|
  Share::Api.chunk(req, rsp, req.named(:token))
end

# GET /<token>/page —— 下载详情页（文件名 + 输密码 + 点下载）
# 想直接拿文件走 GET /<token>，两者语义不同：页面给人看，文件给程序取。
Q.get %r{^/(?<token>[a-f0-9]{16})/page/?$} do |req, rsp|
  return fail(rsp, 404) if Share.find(req.named(:token)).nil?
  share_download_page(rsp)
end

# ── GET /<token> → 下载文件本体 ──────────────────────────
# 放最后：它匹配任何 16 位 hex 单段路径，必须给所有具体路由让路
Q.get %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.content(req, rsp, req.named(:token))
end