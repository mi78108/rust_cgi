#!/usr/bin/env ruby
# frozen_string_literal: true
# tool/share/index — 分享服务的全部 HTTP 端点
#
# 所有路由集中在这里，处理逻辑在 _lib_.rb：
#   Share       领域模型，一个分享是什么、能做什么
#   Share::Api  把 HTTP 请求翻译成对 Share 的调用
# index 自己只做路由分发，不写业务逻辑。
#
# 路由一览（顺序即匹配优先级，从上到下）：
#
#   POST   /                    建分片会话（无 query）/ 一次性上传（有 query）
#   POST   /<token>             一次性上传到指定 token
#   POST   /<token>/complete    分片合并收尾
#   PUT    /<token>             传一片
#   GET    /                    ?t=<token> → 下载详情页 / 无 → 上传页
#   GET    /list                 分享列表（?c= 我的 · ?pub=1 公开）
#   GET    /<token>/list         单条详情（续传入口）
#   GET    /<token>/info         元信息
#   GET    /<token>/view         预览页 HTML
#   GET    /<token>/chunk        内联预览（inline，不扣次数）
#   GET    /<token>/page         下载详情页 HTML
#   GET    /<token>              下载文件本体（attachment，扣次数）
#   PATCH  /<token>              改配置
#   DELETE /<token>              取消分享 / 丢弃未完成
#   GET    /view                 预览页（旧 query 式入口，保留兼容）
#
# 两条要注意的：
#   1. GET /<token> 在最后 —— 它匹配任何 16 位 hex 的单段路径，
#      所有更具体的路由都必须排在它前面。
#   2. /download 之类带目录名的前缀不行 —— spider 的路径解析会先派发到
#      那个目录下的 CGI 脚本，index 拦不到。所以路径一律用 /<token>/xxx。
#
# 存储：$SPIDER_DATA/<token>/{meta.json, data, part/<n>}
#      SPIDER_DATA 未设置时默认 /tmp/share。

require_relative '../../_env_/ruby/_base_'
require_relative '_lib_'

PAGE        = 'dist/page.html'
VIEW_PAGE = 'dist/view.html'
DOWNLOAD_PAGE = 'dist/download.html'

# ══════════════════════════════════════════════════════════════
#  API 路由表
#
#  所有端点集中在这里注册 —— 一个入口，一眼看全部。
#  处理逻辑在 api_*.rb（纯模块，不注册路由）。
#
#  顺序很要紧：下面的短链兜底路由 %r{^/(?<token>[a-f0-9]{16})/?$}
#  会匹配任何 16 位 hex 的单段路径，所以更具体的路由必须排在它前面。
# ══════════════════════════════════════════════════════════════

# POST / —— 建分片会话 还是 一次性上传
#   无 query → 建分片会话（size/chunk 等参数之后放在后续请求里）
#   有 query → 一次性上传（配置参数 c/max/exp/pub/pw 在 query，文件在 multipart body）
#
# nil 也判一下：Q::REQ_PARAMS 默认是空字符串，但显式传 nil 时同样表示「无」。
Q.post '/' do |req, rsp|
  if req.query.nil? || req.query.empty?
    Share::Api.create_session(req, rsp)
  else
    Share::Api.create_share(req, rsp)
  end
end


# POST /<token> —— 一次性上传到指定 token
#   token 已完成（done=1）→ 409，不允许覆盖
#   token 未完成（done=0）→ 允许覆盖（半成品重传）
#   token 不存在         → 直接创建
Q.post %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.create_share(req, rsp, req.named(:token))
end

# complete 排在 <token> 前面 —— 否则 PUT 不受影响，但 POST 会先命中短路径
Q.post %r{^/(?<token>[a-f0-9]{16})/complete$} do |req, rsp|
  Share::Api.complete(req, rsp, req.named(:token))
end

Q.put %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.put_part(req, rsp, req.named(:token))
end

# ── 页面 ──────────────────────────────────────────────────────
#   GET /                     上传页（提取 / 上传 / 我的分享 / 公开分享）
#   GET /view?t=<tok>         预览页
#   GET /download?t=<tok>     下载详情页（路由在 download 脚本里 ——
#                             cgi/tool/share/download 这个目录名会让
#                             spider 先派发到它，index 拦不到）

# ── /tool/share?t=<token> → 下载端点 ────────────────────────
Q.get '/' do |req, rsp|
  t = req.param('t').to_s
  # ?t=<token> → 详情页（保留旧链接可用，新链接是 /<token>/page）
  return serve_html(rsp, DOWNLOAD_PAGE) if Share::TOKEN_RE.match?(t)

  serve_html(rsp, PAGE)
end

# GET /<token>/info —— 分享元信息
# 下载页和预览页加载时用。放在短链兜底之前 —— 短链会匹配任意 16 位 hex 单段。
Q.get %r{^/(?<token>[a-f0-9]{16})/info/?$} do |req, rsp|
  Share::Api.show_info(req, rsp, req.named(:token))
end

# GET /<token>/view —— 这个分享的预览页
# 服务端先校验 token 存在，跟 /info 行为一致 —— 不存在的分享直接 404，
# 别让用户先看到一个空页面再由 JS 报「加载失败」。
Q.get %r{^/(?<token>[a-f0-9]{16})/view/?$} do |req, rsp|
  return err(rsp, 404) if Share.find(req.named(:token)).nil?
  serve_html(rsp, VIEW_PAGE)
end

# GET /view?t=<token> —— 预览页旧入口（query 式）。
# view.html 两种 URL 都认，但这个入口本身可以撤了，留着方便旧链接。
Q.get %r{^/view/?$} do |_req, rsp|
  serve_html(rsp, VIEW_PAGE)
end

# PATCH /<token> —— 改配置（下载次数 / 有效期 / 密码 / 是否公开）
# 原先是 POST /tool/share/edit/<token>，edit 脚本已删除。
Q.patch %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.update(req, rsp, req.named(:token))
end

# DELETE /<token> —— 取消分享 / 丢弃未完成
# 原先是 DELETE /tool/share/delete/<token>，delete 脚本已删除。
Q.delete %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.destroy(req, rsp, req.named(:token))
end


# GET /list —— 分享列表
#   ?c=<clientId>  我的分享
#   ?pub=1         公开广场
#
# /list 是字母，单段路径不会被短链的 16 位 hex 正则匹配到，排哪都行。
Q.get %r{^/list$} do |req, rsp|
  Share::Api.list(req, rsp)
end

# GET /<token>/list —— 单条详情（续传入口）
# 挂在资源下面，跟 /<token>/info、/<token>/view 一致。
Q.get %r{^/(?<token>[a-f0-9]{16})/list/?$} do |req, rsp|
  Share::Api.show(req, rsp, req.named(:token))
end

# GET /<token>/chunk —— 内联预览（inline，不扣下载次数）
# 与 GET /<token>（attachment，扣次数）的区别见 Share::Api.chunk 的注释。
Q.get %r{^/(?<token>[a-f0-9]{16})/chunk/?$} do |req, rsp|
  Share::Api.chunk(req, rsp, req.named(:token))
end

# GET /<token>/page —— 下载详情页（文件名 + 输密码 + 点下载）
# 想直接拿文件走 GET /<token>，两者语义不同：页面给人看，文件给程序取。
Q.get %r{^/(?<token>[a-f0-9]{16})/page/?$} do |req, rsp|
  return err(rsp, 404) if Share.find(req.named(:token)).nil?
  serve_html(rsp, DOWNLOAD_PAGE)
end

# ── GET /<token> → 下载文件本体 ──────────────────────────
# 放最后：它匹配任何 16 位 hex 单段路径，必须给所有具体路由让路
Q.get %r{^/(?<token>[a-f0-9]{16})/?$} do |req, rsp|
  Share::Api.content(req, rsp, req.named(:token))
end